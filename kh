                                        :gsub("%s+$", "")
                                end
                                baseName = tostring(baseName):gsub("%s+$", "")
                                local key = AutoFragmentCleanName(baseName)
                                if key ~= "" and not seen[key] then
                                    seen[key] = true
                                    -- Display: Sand-Sand (x1)
