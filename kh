function nearestIsland(pos)
    local locs = workspace:FindFirstChild("_WorldOrigin")
        and workspace._WorldOrigin:FindFirstChild("Locations")
    if not locs then return "Unknown Island" end
    local best, bestD = nil, math.huge
    for _, p in ipairs(locs:GetChildren()) do
        if p:IsA("BasePart") and not p:GetAttribute("IgnoreInTracking") then
            local d = (p.Position - pos).Magnitude
            if d < bestD then bestD, best = d, p end
        end
    end
    return best and best.Name or "Unknown Island"
end

function findMobPos(mobName)
    if not mobName then return nil end
    local low = string.lower(mobName)
    local my = getPos()

    -- 1) live Enemies
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        local best, bestD = nil, math.huge
        for _, m in ipairs(enemies:GetChildren()) do
            if m:IsA("Model") then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local hrp = m:FindFirstChild("HumanoidRootPart")
                local n = string.lower(m.Name)
                if hum and hrp and hum.Health > 0
                    and n:find(low, 1, true)
                    and not n:find("%[boss%]")
                then
                    local d = (hrp.Position - my).Magnitude
                    if d < bestD then bestD, best = d, hrp.Position end
                end
            end
        end
        if best then return best end
    end

    -- 2) EnemySpawns
    local spawns = workspace:FindFirstChild("_WorldOrigin")
        and workspace._WorldOrigin:FindFirstChild("EnemySpawns")
    if not spawns then return nil end

    local best, bestD = nil, math.huge
    for _, obj in ipairs(spawns:GetChildren()) do
        local n = string.lower(obj.Name)
        if n:find("%[boss%]") then
            continue
        end
        if not n:find(low, 1, true) then
            continue
        end

        local pos = nil
        if obj:IsA("BasePart") then
            pos = obj.Position
        elseif obj:IsA("Model") then
            pos = obj.PrimaryPart and obj.PrimaryPart.Position
            if not pos then
                for _, d in ipairs(obj:GetDescendants()) do
                    if d:IsA("BasePart") then
                        pos = d.Position
                        break
                    end
                end
            end
        end

        if pos then
            local d = (pos - my).Magnitude
            if d < bestD then
                bestD, best = d, pos
            end
        end
    end
    return best
end

function findNPCEntry(npcName, npcPos)
    local list = GuideModule.Data and GuideModule.Data.NPCList
    if type(list) ~= "table" then return nil end
    for _, data in pairs(list) do
        if type(data) == "table" then
            if data.NPCName == npcName then return data end
            if npcPos and data.Position and (data.Position - npcPos).Magnitude < 5 then
                return data
            end
        end
    end
    return nil
end

function levelSetFromNPC(npcData)
    local set = {}
    if not npcData or type(npcData.Levels) ~= "table" then return set end
    for _, req in pairs(npcData.Levels) do
        if type(req) == "number" then set[req] = true end
    end
    return set
end

local function isBossQuest(q)
    if type(q) ~= "table" or type(q.Task) ~= "table" then
        return false
    end
    local kinds, total = 0, 0
    for _, count in pairs(q.Task) do
        kinds += 1
        total += tonumber(count) or 0
    end
    return kinds == 1 and total == 1
end

local function norm(s)
    return string.lower(tostring(s))
        :gsub("%s*quest%s*giver%s*", "")
        :gsub("quest", "")
        :gsub("%s+", "")
        :gsub("%p", "")
end

-- pilih quest tertinggi yang LevelReq <= playerLevel (bukan boss)
local function pickQuestByName(npcName, playerLevel)
    local token = norm(npcName)
    if token == "" then return nil, nil, nil end
    local best, bestKey, bestIndex = nil, nil, nil
    for questKey, list in pairs(Quests) do
        local k = norm(questKey)
        if k:find(token, 1, true) or token:find(k, 1, true) then
            if type(list) == "table" then
                for i, q in ipairs(list) do
                    if type(q) == "table"
                        and type(q.LevelReq) == "number"
                        and q.LevelReq <= playerLevel
                        and not isBossQuest(q)
                    then
                        if not best or q.LevelReq > best.LevelReq then
                            best, bestKey, bestIndex = q, questKey, i
                        end
                    end
                end
            end
        end
    end
    return best, bestKey, bestIndex
end

-- optional: filter pakai levelSet dari NPC (kalau ada)
local function pickQuestAuto(levelSet, playerLevel, npcName)
    -- kalau levelSet kosong, fallback ke nama NPC
    if not levelSet or next(levelSet) == nil then
        return pickQuestByName(npcName, playerLevel)
    end

    local best, bestKey, bestIndex = nil, nil, nil
    for questKey, list in pairs(Quests) do
        if type(list) == "table" then
            for i, q in ipairs(list) do
                if type(q) == "table"
                    and type(q.LevelReq) == "number"
                    and levelSet[q.LevelReq]
                    and q.LevelReq <= playerLevel
                    and not isBossQuest(q)
                then
                    if not best or q.LevelReq > best.LevelReq then
                        best, bestKey, bestIndex = q, questKey, i
                    end
                end
            end
        end
    end

    if best then
        return best, bestKey, bestIndex
    end
    return pickQuestByName(npcName, playerLevel)
end

