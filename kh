local function HasSafeProtectedItem()
    local player = game:GetService("Players").LocalPlayer
    if not player then return false, nil end

    local containers = {
        player:FindFirstChild("Backpack"),
        player.Character,
    }

    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    if ProtectedItemNames[item.Name] or ProtectedFruitNames[item.Name] then
                        return true, item.Name
                    end
                end
            end
        end
    end

    return false, nil
end

local function GetBypassSpawn(target)
    local locations = workspace:FindFirstChild("_WorldOrigin")
        and workspace._WorldOrigin:FindFirstChild("Locations")
    if not locations then return nil end

    local nearest, nearestDistance = nil, math.huge
    for _, location in ipairs(locations:GetChildren()) do
        if location:IsA("BasePart") then
            local d = (location.Position - target.Position).Magnitude
            if d < nearestDistance then
                nearestDistance = d
                nearest = location
            end
        end
    end

    return nearest
end

function WaitForCharacter(timeout)
    local player = game:GetService("Players").LocalPlayer
    local deadline = os.clock() + (timeout or 12)

    while os.clock() < deadline do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if character and humanoid and root and humanoid.Health > 0 then
            return character, humanoid, root
        end
        task.wait(0.15)
    end
end

local function SmartBypass(target)
    if SmartBypassBusy or not _G.BypassTeleport then return false end

    SmartBypassBusy = true
    local routeVersion = _G.BypassTeleportVersion or 0

    local function RouteValid()
        return _G.BypassTeleport == true
            and (_G.BypassTeleportVersion or 0) == routeVersion
            and _G.SmartBypassCancelled ~= true
            and _G.StopTween ~= true
    end

    local ok, result = pcall(function()
        local character, humanoid, root = GetCharacter()
        if not character or not humanoid or not root then return false end
        if not RouteValid() then return false end

        local spawnPoint = GetBypassSpawn(target)
        if not spawnPoint then return false end

        StopCurrentTween()
        if not RouteValid() then return false end

        -- Move to the destination spawn and save it as the respawn point.
        root.CFrame = spawnPoint.CFrame + Vector3.new(0, 5, 0)
        task.wait(0.2)
        if not RouteValid() then return false end

        local setSpawnOK = false
        pcall(function()
            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("SetSpawnPoint")
            setSpawnOK = true
        end)
        if not setSpawnOK then return false end

