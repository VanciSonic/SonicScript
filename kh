            AutoFragmentRaid = value
        end)

        AutoFragmentStatus = AutoFragmentSection:AddParagraph({
            Title = "Status",
            Content = "Disabled"
        })

        v16.Raid:AddToggle("ToggleAutoFarmFragment", {
            Title = "Auto Farm Fragment",
            Description = "Load 1 fruit > Buy Chip > Start Raid > Kill Aura > Scan Island 1-5 > Loop",
            Default = false,
            Callback = function(enabled)
                AutoFragmentRunning = enabled
                AutoFragmentInRaid = false
                TweenStopCek(enabled)

                if enabled then
                    AutoFragmentSaved = {
                        AutoNear = _G.AutoNear == true,
                        AutoBuy = _G.Auto_Buy_Chips_Dungeon == true,
                        AutoStart = _G.Auto_StartRaid == true,
                        AutoNext = AutoNextIsland == true,
                    }
                    -- Matikan fitur lain yang bentrok gerak
                    _G.Auto_Buy_Chips_Dungeon = false
                    _G.Auto_StartRaid = false
                    AutoNextIsland = false
                    _G.AutoNear = false
                            AutoFragmentBusy = false
                else
                            AutoFragmentBusy = false
                    if AutoFragmentSaved then
                        _G.AutoNear = AutoFragmentSaved.AutoNear
                        _G.Auto_Buy_Chips_Dungeon = AutoFragmentSaved.AutoBuy
                        _G.Auto_StartRaid = AutoFragmentSaved.AutoStart
                        AutoNextIsland = AutoFragmentSaved.AutoNext
                    else
                        _G.AutoNear = false
                    end
                    AutoFragmentSaved = nil
                    pcall(function() AutoFragmentStatus:SetDesc("Disabled") end)
                end
            end
        })

        task.spawn(function()
            while task.wait(0.35) do
                if not AutoFragmentRunning then
                            AutoFragmentBusy = false
                    continue
                end
                if AutoFragmentBusy then
                    continue
                end

                AutoFragmentBusy = true
                pcall(function()
                    local selectedCount = 0
                    for _, enabled in pairs(AutoFragmentSelectedFruits) do
                        if enabled then selectedCount += 1 end
                    end
                    if selectedCount == 0 then
                        AutoFragmentStatus:SetDesc("Select at least 1 fruit")
                        return
                    end

                    -- Jangan pakai AutoNear (tween ke musuh = gerakan aneh)
                    _G.AutoNear = false
                    AutoNextIsland = false

                    -- Jangan cek HUD sebagai kondisi awal. Flow wajib dimulai dari Fruit.
                    if AutoFragmentInRaid then
                        AutoFragmentStatus:SetDesc("Raid active → Island 1-5 + Kill Aura")
                        AutoFragmentFarmIslands()
                        return
                    end

                    -- 1) Load 1 fruit terpilih
                    AutoFragmentStatus:SetDesc("Loading selected fruit...")
                    local fruitTool = AutoFragmentLoadSelectedFruit()
                    if not fruitTool then
                        AutoFragmentStatus:SetDesc("No selected fruit left in inventory")
                        return
                    end
                    AutoFragmentStatus:SetDesc("Loaded: " .. tostring(fruitTool.Name))

                    -- 2) Buy chip sesuai dropdown raid
                    AutoFragmentStatus:SetDesc("Buying chip: " .. tostring(AutoFragmentRaid))
                    for _ = 1, 25 do
                        if not AutoFragmentRunning then return end
                        if AutoFragmentHasChip() then break end
                        AutoFragmentBuyChip()
                        task.wait(0.25)
                    end
                    if not AutoFragmentHasChip() then
                        AutoFragmentStatus:SetDesc("Failed to buy Special Microchip")
                        return
                    end

                    -- 3) Tween ke tempat start raid
                    AutoFragmentStatus:SetDesc("Going to raid pad...")
                    AutoFragmentGoToRaidPad()
                    if not AutoFragmentRunning then return end

                    -- Sampai di pad → STOP tween dulu sebelum klik start
                    AutoFragmentStatus:SetDesc("At pad — stop tween, prepare start...")
                    AutoFragmentFreezePlayer()
                    task.wait(0.35)

                    -- 4) Start raid (equip chip + click) — player DIAM, no tween
                    AutoFragmentStatus:SetDesc("Starting raid — SetSpawnPoint + equip + click...")
                    local started = AutoFragmentStartRaid()
                    if not started then
                        AutoFragmentStatus:SetDesc("Raid start failed — chip/click not accepted")
                        AutoFragmentUnfreezeForFarm()
                        return
                    end

                    -- 5) Setelah Click RaidSummon2: DIAM sampai TopHUDList/RaidTimer + Island 1 siap.
                    AutoFragmentStatus:SetDesc("Waiting TopHUDList/RaidTimer + Island 1...")
                    local island1 = nil
                    local waitUntil = tick() + 70
                    while AutoFragmentRunning and tick() < waitUntil do
                        AutoFragmentFreezePlayer()
                        if AutoFragmentRaidActive() then
                            island1 = AutoFragmentGetIslandById(1, 2500)
                            if island1 then break end
                        end
                        task.wait(0.15)
                    end

                    if not AutoFragmentRunning then
                        AutoFragmentInRaid = false
                        return
                    end

                    if not AutoFragmentRaidActive() or not island1 then
                        AutoFragmentInRaid = false
                        AutoFragmentStatus:SetDesc("RaidTimer/Island 1 timeout — retry next loop")
                        AutoFragmentFreezePlayer()
                        task.wait(1)
                        return
                    end

                    -- 6) Baru setelah HUD + RaidTimer + Island 1 aktif: tween Island 1 → 5.
                    AutoFragmentInRaid = true
                    AutoFragmentStatus:SetDesc("Raid active — Island 1 → 5")
                    AutoFragmentUnfreezeForFarm()
                    AutoFragmentWatchRaidHUD()
                    AutoFragmentFarmIslands()

                    if AutoFragmentRunning and not AutoFragmentInRaid then
                        AutoFragmentStatus:SetDesc("RaidTimer false — STOP tween, waiting return...")
                        AutoFragmentStopAfterRaid()
                    end
                    task.wait(1)
                end)
                AutoFragmentBusy = false
            end
        end)
    end
end
