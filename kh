        local function AutoFragmentStartRaid()
            if AutoFragmentInRaid then return true end
            if not AutoFragmentHasChip() then return false end

            AutoFragmentFreezePlayer()
            task.wait(0.2)
            pcall(function() AutoFragmentComm:InvokeServer("SetSpawnPoint") end)
