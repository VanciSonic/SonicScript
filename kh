local function MultiStoreGetMarker(tool)
    if not tool or not tool.FindFirstChild then
        return nil
    end

    return tool:FindFirstChild("__GHubStoreCapacityBlocked")
end

local function MultiStoreMarkBlocked(tool, canonical)
    if not tool or not tool.Parent then
        return
    end

    local marker = MultiStoreGetMarker(tool)
    if not marker then
        marker = Instance.new("BoolValue")
        marker.Name = "__GHubStoreCapacityBlocked"
        marker.Value = true
        marker.Parent = tool
    else
        marker.Value = true
    end

    pcall(function()
        tool:SetAttribute("__GHubStoreCapacityBlocked", true)
    end)

    -- Keep the canonical value only for this live Tool instance.
    pcall(function()
        tool:SetAttribute("__GHubStoreCanonical", canonical)
    end)
end

local function MultiStoreIsBlocked(tool)
    local marker = MultiStoreGetMarker(tool)
    return marker and marker:IsA("BoolValue") and marker.Value == true
end

local function MultiStoreGetCanonicalFruit(tool)
    if not tool then
        return nil
    end

    return MultiStoreFruitMap[tool.Name]
end

local function MultiStoreGetStoreName(tool, canonical)
    local originalName = tool and tool:GetAttribute("OriginalName")

    if type(originalName) == "string" and originalName ~= "" then
        return originalName
    end

    local base = tool and tool.Name and tool.Name:gsub("%s*Fruit%s*$", "")
    if base and base ~= "" then
        return base .. "-" .. base
    end

    return canonical
end

local function MultiStoreGetFruitCap()
    local player = game:GetService("Players").LocalPlayer
    local data = player and player:FindFirstChild("Data")
    local cap = data and data:FindFirstChild("FruitCap")

    if cap and cap:IsA("ValueBase") then
        return tonumber(cap.Value) or 0
    end

    return 0
end

local function MultiStoreGetFruitCount(canonical)
    if type(GetItemCount) ~= "function" then
        return nil
    end

    local ok, count = pcall(function()
        return GetItemCount(canonical)
    end)

    if not ok then
        return nil
    end

    count = tonumber(count)
    if not count then
        return nil
    end

    return math.max(0, math.floor(count))
end

function MultiStoreIsCapacityReached(canonical)
    local cap = MultiStoreGetFruitCap()

    if cap <= 0 then
        return false, 0, cap
    end

    local count = MultiStoreGetFruitCount(canonical)

    if count == nil then
        return false, nil, cap
    end

    return count >= cap, count, cap
end

local function MultiStoreCollectPhysicalFruits()
    local player = game:GetService("Players").LocalPlayer
    local backpack = player and player:FindFirstChild("Backpack")
    local character = player and player.Character
    local candidates = {}

    local function collect(container)
        if not container then
            return
        end

        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("Tool") then
                local canonical = MultiStoreGetCanonicalFruit(obj)

                if canonical and not candidates[canonical] then
                    candidates[canonical] = obj
                end
            end
        end
    end

    collect(backpack)
    collect(character)

    return candidates
end

local function MultiStoreEquipFruit(tool)
    if not tool then
        return false
    end

    local player = game:GetService("Players").LocalPlayer
    local character = player and player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not character or not humanoid then
        return false
    end

    if tool.Parent ~= character then
        pcall(function()
            humanoid:EquipTool(tool)
        end)

        task.wait(0.20)
    end

    return tool.Parent == character
end

local function MultiStoreUnequipFruit()
    local player = game:GetService("Players").LocalPlayer
    local character = player and player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        pcall(function()
            humanoid:UnequipTools()
        end)
    end
end

local MultiStorePendingUntil = {}

local function MultiStoreFruitOnce()
    local player = game:GetService("Players").LocalPlayer
    if not player then
        return
    end

    local comm = game:GetService("ReplicatedStorage")
        :FindFirstChild("Remotes")
        and game:GetService("ReplicatedStorage").Remotes:FindFirstChild("CommF_")

    if not comm then
        return
    end

    local candidates = MultiStoreCollectPhysicalFruits()

    for canonical, tool in pairs(candidates) do
        if not tool or not tool.Parent then
            continue
        end

        -- Marker is attached to this exact Tool instance only.
        if MultiStoreIsBlocked(tool) then
            continue
        end

        local pending = MultiStorePendingUntil[canonical]
        if pending and os.clock() < pending then
            continue
        end

        -- =====================================================
        -- INVENTORY CHECK
        -- GetItemCount() reads the actual ItemReplicationService
        -- inventory, not Backpack.
        -- =====================================================
        local count = MultiStoreGetFruitCount(canonical)
        local cap = MultiStoreGetFruitCap()

        -- Inventory query must work before we touch StoreFruit.
        if count == nil or cap <= 0 then
            continue
        end

        -- Example:
        -- Smoke = 3, FruitCap = 6 -> still allowed to store.
        -- Smoke = 6, FruitCap = 6 -> permanently block THIS Tool.
        if count >= cap then
            MultiStoreMarkBlocked(tool, canonical)
            continue
        end

        -- =====================================================
        -- STORE
        -- =====================================================
        if not MultiStoreEquipFruit(tool) then
            MultiStorePendingUntil[canonical] = os.clock() + 1.0
            continue
        end

        local storeName = MultiStoreGetStoreName(tool, canonical)

        local ok, result = pcall(function()
            return comm:InvokeServer("StoreFruit", storeName, tool)
        end)

        -- Never leave the fruit equipped while another Multi Farm
        -- mode is supposed to take control.
        task.wait(0.12)
        MultiStoreUnequipFruit()

        -- Successful remote response: give the inventory replication
        -- a moment, then read the actual count again.
        if ok and result == true then
            MultiStorePendingUntil[canonical] = os.clock() + 0.75
            task.wait(0.30)

            local newCount = MultiStoreGetFruitCount(canonical)

            if newCount and newCount >= cap then
                -- Mark the current Tool if it still exists.
                MultiStoreMarkBlocked(tool, canonical)
            end

        else
            -- Store rejected/failed. Do NOT permanently block the fruit:
            -- it may simply be a transient server/client sync issue.
            MultiStorePendingUntil[canonical] = os.clock() + 2.0
        end
    end
end

