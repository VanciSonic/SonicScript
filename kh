local TweenService = game:GetService("TweenService")

plr = Players.LocalPlayer
TweenSpeed = 165

ActiveTween = nil
TweenToken = 0
TweenProxy = nil
_G.StopTween = false

function GetCharacter()
    local c = plr.Character
    if not c then return end

    local h = c:FindFirstChildOfClass("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")

    if not h or not hrp then return end
    return c, h, hrp
end

function StopCurrentTween()
    TweenToken += 1

    if ActiveTween then
        pcall(function()
            ActiveTween:Cancel()
        end)
        ActiveTween = nil
    end

    if TweenProxy then
        pcall(function()
            TweenProxy:Destroy()
        end)
        TweenProxy = nil
    end

    _G.Sys1 = false
    _G.Sys2 = false
end

function NormalTween(v211)
    if typeof(v211) ~= "CFrame" then return end
    if _G.StopTween then return end

    local c, h, hrp = GetCharacter()
    if not c or not h or not hrp then return end
    if h.Health <= 0 then return end

    StopCurrentTween()

    if _G.StopTween then return end

    TweenToken += 1
    local token = TweenToken

    local distance = (v211.Position - hrp.Position).Magnitude
    local time = math.max(distance / math.max(TweenSpeed, 1), 0.05)

    local target = hrp

    if h.Sit then
        local proxy = Instance.new("Part")
        proxy.Name = "TweenProxy"
        proxy.Anchored = true
        proxy.CanCollide = false
        proxy.Transparency = 1
        proxy.Size = Vector3.new(1, 1, 1)
        proxy.CFrame = hrp.CFrame
        proxy.Parent = workspace

        TweenProxy = proxy
        target = proxy
    end

    local obj = TweenService:Create(
        target,
        TweenInfo.new(time, Enum.EasingStyle.Linear),
        {CFrame = v211}
    )

    ActiveTween = obj
    _G.Sys1 = true
    _G.Sys2 = true

    obj:Play()

    task.spawn(function()
        while obj.PlaybackState == Enum.PlaybackState.Playing do
            if token ~= TweenToken
                or _G.StopTween
                or not c.Parent
                or not h.Parent
                or h.Health <= 0
            then
                pcall(function()
                    obj:Cancel()
                end)
                break
            end

            if h.Sit and target ~= hrp then
                hrp.CFrame = target.CFrame
            end

            task.wait()
        end

        if token == TweenToken
            and not _G.StopTween
            and c.Parent
            and h.Health > 0
            and h.Sit
            and target ~= hrp
        then
            hrp.CFrame = target.CFrame
        end

        if ActiveTween == obj then
            ActiveTween = nil
        end

        if TweenProxy == target then
            TweenProxy = nil
            pcall(function()
                target:Destroy()
            end)
        elseif target ~= hrp then
            pcall(function()
                target:Destroy()
            end)
        end

        if token == TweenToken then
            _G.Sys1 = false
            _G.Sys2 = false
        end
    end)
end

