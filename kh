Secret39.RenderQuestStatus = function(extra)
    local islandName = Secret39.SelectedIsland or Secret39.IslandNames[1]
    local items = Secret39.GetIslandItems(islandName)
    local progress = Secret39.ProgressData
    local done = 0
    local lines = {}

    for _, item in ipairs(items) do
        if Secret39.IsComplete(item, progress) then
            done += 1
        end
    end

    local stars = string.rep("⭐", done) .. string.rep("☆", math.max(0, #items - done))
    table.insert(lines, ("%s — %s (%d/%d)"):format(islandName, stars, done, #items))

    for _, item in ipairs(items) do
        local mark = Secret39.IsComplete(item, progress) and "✅" or "⬜"
        table.insert(lines, mark .. " " .. item.Name)
    end

    if extra and tostring(extra) ~= "" then
        table.insert(lines, "")
        table.insert(lines, tostring(extra))
    end

    return table.concat(lines, "\n")
end

