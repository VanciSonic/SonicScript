                                local storageKey = tostring(index.StorageKey or "")
                                local debugLabel = tostring(index.DebugLabel or index.Name or "")
                                -- Prefer StorageKey format: Sand-Sand, Pain-Pain, Spin-Spin
                                local baseName = storageKey
                                if baseName == "" then
