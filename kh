Secret39.Waiting = function(key, title, text)
    key = tostring(key or "generic")
    title = title or "Menunggu"
    text = text or "Menunggu..."

    if Secret39.WaitingKey ~= key then
        Secret39.WaitingKey = key
        Secret39.WaitingSince = os.clock()
        Secret39.LastWaitText = text
        Secret39.Status("⏳ " .. title .. " — " .. text)
        Secret39.Notify("wait:" .. key, title, text, 0)
        return true
    end

    Secret39.LastWaitText = text
    local elapsed = os.clock() - (Secret39.WaitingSince or os.clock())
    Secret39.Status(("⏳ %s — %s [%ds]"):format(title, text, math.floor(elapsed)))
    if elapsed >= Secret39.WaitNoticeEvery then
        Secret39.Notify("wait:" .. key, title, text, Secret39.WaitNoticeEvery)
        Secret39.WaitingSince = os.clock()
    end
    return true
end

