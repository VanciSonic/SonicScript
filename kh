    end

    local function ATL_FindMirage()
        local boat = ATL_Boat() or ATL_BuyBoat()
        if not boat then
            ATL_SetStatus("Tiki", "Boat failed")
            return false
        end

        local _, _, hum = ATL_Alive()
        if hum and not hum.Sit then
            local seat = boat:FindFirstChild("VehicleSeat", true)
            if seat then
                ATL_SetStatus("Tiki", "Boarding boat")
                ATL_Move(seat.CFrame * CFrame.new(0, 1, 0), 8, 10)
                task.wait(0.5)
            end
        end

        local deadline = os.clock() + 180
        while ATL.On and os.clock() < deadline do
            local island = ATL_Mirage()
            if island then
                pcall(function()
                    if hum then hum.Sit = false end
                end)
                return true
            end

            boat = ATL_Boat()
            if not boat then
                boat = ATL_BuyBoat()
                if not boat then
                    task.wait(1)
                    continue
                end
            end

            local seat = boat:FindFirstChild("VehicleSeat", true)
            local alive, _, h = ATL_Alive()
            if alive and h and not h.Sit and seat then
                ATL_Move(seat.CFrame * CFrame.new(0, 1, 0), 8, 8)
                task.wait(0.4)
            elseif alive and h and h.Sit then
                ATL_SetStatus("Mirage", "Searching...")
                local route = CFrame.new(-10000000, 31, 37016.25)
                if CheckEnemiesBoat() or CheckTerrorShark() or CheckPirateGrandBrigade() then
                    route = CFrame.new(-10000000, 150, 37016.25)
                end
                pcall(function() Tween(route) end)
                task.wait(1)
            else
                task.wait(0.5)
            end
        end
        return false
    end

    local function ATL_Resonate()
        if not ATL_HasItem("Mirror Fractal") then
            ATL_SetStatus("Blocked", "Need Mirror Fractal / Dough King")
            return false
        end

        while ATL.On and not ATL_Night() do
            ATL_SetStatus("Mirage", "Waiting night")
            task.wait(1)
        end
        if not ATL.On then return false end

        local high = ATL_HighestPoint()
        if not high then
            ATL_SetStatus("Mirage", "Highest point not found")
            return false
        end

        local target = high.CFrame * CFrame.new(0, 211.88, 0)
        ATL_SetStatus("Mirage", "Highest point")
        if not ATL_Move(target, 12, 15) then
            ATL_SetStatus("Mirage", "Move failed")
            return false
        end

        local cam = workspace.CurrentCamera
        local started = os.clock()
        local token = ATL.Token
        ATL_SetStatus("Moon", "Lock + V3")

        while ATL.On and token == ATL.Token and os.clock() - started < 12 do
            if not ATL_Night() then break end
            local alive, _, _, root = ATL_Alive()
            if not alive then
                task.wait(0.3)
                continue
            end

            local dir = ATLLighting:GetMoonDirection()
            if dir.Magnitude > 0 then
                pcall(function()
                    cam.CameraType = Enum.CameraType.Scriptable
                    cam.CFrame = CFrame.lookAt(root.Position, root.Position + dir * 1000)
                end)
            end
            pcall(function()
                ATLCommE:FireServer("ActivateAbility")
            end)
            task.wait(0.35)

            if ATL_BlueGear() then
                pcall(function()
                    if cam then cam.CameraType = Enum.CameraType.Custom end
                end)
                return true
            end
        end

        pcall(function()
            if cam then cam.CameraType = Enum.CameraType.Custom end
        end)
        return ATL_BlueGear() ~= nil
    end

    local function ATL_GetProgress()
        local ok, v = ATL_Call("RaceV4Progress", "Check")
        return ok and tonumber(v) or nil
    end

    local function ATL_FinishSealedKing()
        for _ = 1, 8 do
            if not ATL.On then return false end
            local progress = ATL_GetProgress()
            if progress == nil then
                ATL_SetStatus("Blocked", "RaceV4Progress error")
                return false
            end
            if progress >= 5 then
                return true
            elseif progress == 0 then
                ATL_SetStatus("Blocked", "Need Rip Indra / Sealed King")
                return false
            elseif progress == 1 then
                ATL_SetStatus("Sealed King", "Finishing dialogue")
                ATL_Call("RaceV4Progress", "Begin")
            elseif progress == 2 then
                ATL_SetStatus("Great Tree", "Opening Temple path")
                ATL_Call("RaceV4Progress", "Teleport")
                task.wait(1)
                ATL_Call("RaceV4Progress", "TeleportBack")
                task.wait(0.5)
            elseif progress == 3 then
                ATL_SetStatus("Sealed King", "Confirming Light")
                ATL_Call("RaceV4Progress", "Continue")
            elseif progress == 4 then
                ATL_SetStatus("Sealed King", "Confirming Light")
                ATL_Call("RaceV4Progress", "Continue")
            end
            task.wait(0.8)
        end
        return ATL_GetProgress() and ATL_GetProgress() >= 5
    end

    local function ATL_PullLever()
        local temple = workspace:FindFirstChild("Map")
            and workspace.Map:FindFirstChild("Temple of Time")
        if not temple then
            pcall(function()
                ATL_Call("requestEntrance", ATL_TempleEntrance().Position)
            end)
            task.wait(1)
            temple = workspace:FindFirstChild("Map")
                and workspace.Map:FindFirstChild("Temple of Time")
        end
        if not temple then
            ATL_SetStatus("Temple", "Map not loaded")
            return false
        end

        local lever = temple:FindFirstChild("Lever", true)
        if not lever then
            ATL_SetStatus("Temple", "Lever not found")
            return false
        end

        ATL_SetStatus("Temple", "Pulling lever")
        for _ = 1, 4 do
            if not ATL.On then return false end
            local prompt
            for _, v in ipairs(lever:GetDescendants()) do
                if v:IsA("ProximityPrompt") then
                    prompt = v
                    break
                end
            end
            if prompt then
                pcall(function()
                    if fireproximityprompt then
                        fireproximityprompt(prompt, 1, true)
                    else
                        prompt:InputHoldBegin()
                        task.wait(prompt.HoldDuration or 0.1)
                        prompt:InputHoldEnd()
                    end
                end)
            end
            task.wait(0.6)
            local ok, door = ATL_Call("CheckTempleDoor")
            if ok and door == true then
                ATL_SetStatus("DONE", "Temple lever unlocked")
                return true
            end
        end
        ATL_SetStatus("Temple", "Lever not confirmed")
        return false
    end

    local function ATL_Run()
        if ATL.Busy then return end
        ATL.Busy = true
        ATL.Token += 1
        local token = ATL.Token

        local ok, result = pcall(function()
            if not World3 then
                ATL_SetStatus("Blocked", "Sea 3 only")
                return
            end

            if not ATL_FinishSealedKing() then return end
            if not ATL.On or token ~= ATL.Token then return end

            local doorOK = false
            pcall(function()
                local a, b = ATL_Call("CheckTempleDoor")
                doorOK = a and b == true
            end)
            if doorOK then
                ATL_SetStatus("DONE", "Lever already unlocked")
                return
            end

            if not ATL_HasItem("Mirror Fractal") then
                ATL_SetStatus("Blocked", "Need Mirror Fractal / Dough King")
                return
            end

            ATL_SetStatus("Tiki", "Going to boat dealer")
            if not ATL_FindMirage() then
                ATL_SetStatus("Blocked", "Mirage not found")
                return
            end

            if not ATL_Resonate() then
                ATL_SetStatus("Moon", "Resonance failed, retrying")
                return
            end

            local gear
            local deadline = os.clock() + 45
            repeat
                if not ATL.On or token ~= ATL.Token then return end
                gear = ATL_BlueGear()
                if gear then break end
                ATL_SetStatus("Blue Gear", "Searching...")
                task.wait(0.5)
            until os.clock() >= deadline

            if not gear then
                ATL_SetStatus("Blocked", "Blue Gear not found")
                return
            end

            local gearCF = gear.CFrame + Vector3.new(0, 2, 0)
            ATL_SetStatus("Blue Gear", "Collecting")
            if not ATL_Move(gearCF, 10, 15) then
                ATL_SetStatus("Blocked", "Gear move failed")
                return
            end

            task.wait(1)
            local door = false
            pcall(function()
                local a, b = ATL_Call("CheckTempleDoor")
                door = a and b == true
            end)
            if not door then
                ATL_SetStatus("Blue Gear", "Waiting server confirm")
                for _ = 1, 8 do
                    task.wait(0.5)
                    local a, b = ATL_Call("CheckTempleDoor")
                    if a and b == true then
                        door = true
                        break
                    end
                end
            end
            if not door then
                ATL_SetStatus("Blocked", "Blue Gear not confirmed")
                return
            end

            ATL_SetStatus("Temple", "Returning")
            pcall(function()
                ATL_Call("requestEntrance", ATL_TempleEntrance().Position)
            end)
            task.wait(1.2)
            ATL_PullLever()
        end)

        if not ok then
            ATL_SetStatus("ERROR", tostring(result))
        end
        ATL.Busy = false
    end

