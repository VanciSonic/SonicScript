function doTP(cf)
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if typeof(Tween) == "function" then
        Tween(cf)
    elseif typeof(Tween) == "function" then
        Tween(cf)
    else
        hrp.CFrame = cf
    end
end

function runTravelRule(rule)
    -- 1) requestEntrance (Fishman / Sky / Ship)
    if rule.Entrance then
        pcall(function()
            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("requestEntrance", rule.Entrance)
        end)
        return
    end

    -- 2) Dock + remote (Submerged)
    if rule.DockCF then
        doTP(rule.DockCF)
        task.wait(rule.WaitAfterTP or 2)
    end

    if type(rule.RemotePath) == "table" then
        pcall(function()
            local obj = game:GetService("ReplicatedStorage")
            for _, name in ipairs(rule.RemotePath) do
                obj = obj:FindFirstChild(name)
                if not obj then return end
            end
            if obj.InvokeServer then
                obj:InvokeServer(unpack(rule.RemoteArgs or {}))
            end
        end)
    end
end

CheckQuestMob = function()
    local q = GetQuestAtribute()
    Ms = q.NpcTargetName
    NameMon = q.NpcTargetName
    NameQuest = q.QuestKey
    QuestLv = q.QuestIndex

    local OFFSET = CFrame.new(0, 40, 0)

    if typeof(q.NpcPos) == "Vector3" then
        CFrameQ = CFrame.new(q.NpcPos) * OFFSET
    elseif typeof(q.NpcPos) == "CFrame" then
        CFrameQ = q.NpcPos * OFFSET
    else
        CFrameQ = nil
    end

    if typeof(q.NpcTargetPos) == "Vector3" then
        CFrameMon = CFrame.new(q.NpcTargetPos) * OFFSET
    elseif typeof(q.NpcTargetPos) == "CFrame" then
        CFrameMon = q.NpcTargetPos * OFFSET
    else
        CFrameMon = nil
    end

    -- cek travel
    if not CFrameQ then return end
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local level = getLevel()
    local dist = (CFrameQ.Position - hrp.Position).Magnitude

