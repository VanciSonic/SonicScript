            return true
        end
        Secret39.Waiting(
            "players:" .. tostring(item and item.Name or "unknown") .. ":" .. tostring(minPlayers),
            "Butuh player lain",
            text or ((item and item.Name or "Secret ini") .. " membutuhkan minimal " .. tostring(minPlayers) .. " player di server. Saat ini " .. tostring(count) .. ".")
