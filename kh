function NewBringMob(mobname, targetCF)
    if not mobname then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- biar client bisa gerakin NPC
    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", 1000)
    end)

    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return end

    local low = string.lower(mobname)
    local matches = {}

    for _, enemy in ipairs(folder:GetChildren()) do
        local n = string.lower(enemy.Name)
        -- exact ATAU partial match
        if n == low or n:find(low, 1, true) then
            local hum = enemy:FindFirstChildOfClass("Humanoid")
            local root = enemy:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                local dist = (root.Position - hrp.Position).Magnitude
                if dist <= RANGE then
                    table.insert(matches, {model = enemy, root = root, hum = hum})
                end
            end
        end
    end

    if #matches == 0 then return end

    -- titik kumpul: targetCF (mob yang lagi di-hit) / posisi player
    local gatherCF = targetCF
    if typeof(gatherCF) ~= "CFrame" then
        gatherCF = hrp.CFrame
    end

    for _, data in ipairs(matches) do
        pcall(function()
            data.hum.WalkSpeed = 0
            data.hum.JumpPower = 0
            data.root.AssemblyLinearVelocity = Vector3.zero
            data.root.AssemblyAngularVelocity = Vector3.zero
            data.root.CFrame = gatherCF
            -- optional: data.root.Anchored = true
        end)
    end
end

