    local function GetNearestRaidIslandById(id)
        local locations = game:GetService("Workspace"):FindFirstChild("_WorldOrigin")
        locations = locations and locations:FindFirstChild("Locations")
        if not locations then return nil end

        local char = game.Players.LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end

        local wanted = "Island " .. tostring(id)
        local best, bestDist = nil, math.huge

        for _, obj in ipairs(locations:GetChildren()) do
            if obj.Name == wanted then
                local pos
                if obj:IsA("BasePart") then
                    pos = obj.Position
                elseif obj:IsA("Model") then
                    local pp = obj.PrimaryPart
                    if pp then
                        pos = pp.Position
                    else
                        local part = obj:FindFirstChildWhichIsA("BasePart", true)
                        pos = part and part.Position
                    end
                end

                if pos then
                    local dist = (pos - root.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = obj
                    end
                end
            end
        end

        return best, bestDist
    end

