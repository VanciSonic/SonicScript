MAGNET_SCAN_DURATION = 1

local MAGNET_BLACKLIST_ENEMYSPAWNS = {
    -- ["namaspawn"] = true,
}

local function MagnetGetPos(obj)
    if not obj then return end
    if obj:IsA("BasePart") then return obj.Position end
    local ok, cf = pcall(function() return obj:GetPivot() end)
    return ok and typeof(cf) == "CFrame" and cf.Position or nil
end

local function MagnetIsland(pos)
    if typeof(nearestIsland) == "function" then
        local ok, name = pcall(nearestIsland, pos)
        if ok and name then return string.lower(tostring(name)) end
    end
    return "unknown island"
end

local function MagnetSkipSpawn(spawnObj, island)
    local islandName = string.lower(tostring(island or ""))
    local spawnName = string.lower(tostring(spawnObj.Name or ""))
    local displayName = string.lower(tostring(spawnObj:GetAttribute("DisplayName") or ""))
    local raw = spawnName .. " " .. displayName

    if MAGNET_BLACKLIST_ISLANDS[islandName]
        or islandName:find("fishman", 1, true)
        or islandName:find("underwater", 1, true)
        or islandName:find("sewer", 1, true)
        or raw:find("boss", 1, true)
    then
        return true
    end

    return MAGNET_BLACKLIST_ENEMYSPAWNS[spawnName]
        or MAGNET_BLACKLIST_ENEMYSPAWNS[displayName]
end

local function MagnetBuildPoints()
    local points = {}
    local grouped = {}
    local origin = workspace:FindFirstChild("_WorldOrigin")
    local spawns = origin and origin:FindFirstChild("EnemySpawns")
    if not spawns then return points end

    -- 1 island -> 1 point untuk tiap enemy type.
    -- Kalau island cuma punya 1 enemy type -> 2 point dengan jarak 120 studs.
    for _, spawnObj in ipairs(spawns:GetChildren()) do
        local pos = MagnetGetPos(spawnObj)
        if pos then
            local island = MagnetIsland(pos)
            local enemyName = tostring(spawnObj:GetAttribute("DisplayName") or spawnObj.Name or "")

            if enemyName ~= "" and not MagnetSkipSpawn(spawnObj, island) then
                grouped[island] = grouped[island] or {}
                grouped[island][enemyName] = grouped[island][enemyName] or {}
                grouped[island][enemyName][#grouped[island][enemyName] + 1] = pos
            end
        end
    end

    local islandNames = {}
    for island in pairs(grouped) do
        islandNames[#islandNames + 1] = island
    end
    table.sort(islandNames)

    for _, island in ipairs(islandNames) do
        local enemyGroups = grouped[island]
        local enemyNames = {}
        for enemyName in pairs(enemyGroups) do
            enemyNames[#enemyNames + 1] = enemyName
        end
        table.sort(enemyNames)

        -- Ambil center island buat menentukan arah split point.
        local center
        local locs = origin and origin:FindFirstChild("Locations")
        if locs then
            for _, loc in ipairs(locs:GetChildren()) do
                if loc:IsA("BasePart") and string.lower(loc.Name) == string.lower(island) then
                    center = loc.Position
                    break
                end
            end
        end

        for _, enemyName in ipairs(enemyNames) do
            local spawnPoints = enemyGroups[enemyName]
            local base = spawnPoints[1]

            -- Normal: 1 sample EnemySpawn untuk 1 enemy type.
            if #enemyNames > 1 then
                points[#points + 1] = {
                    Island = island,
                    Name = enemyName,
                    CFrame = CFrame.new(base + Vector3.new(0, 40, 0)),
                }
            else
                -- 1 enemy type: 2 scan point, total separation 120 studs.
                local dir = Vector3.new(1, 0, 0)
                if center then
                    local flat = Vector3.new(base.X - center.X, 0, base.Z - center.Z)
                    if flat.Magnitude > 0.01 then
                        dir = flat.Unit
                    end
                end

                local p1 = base + dir * 60
                local p2 = base - dir * 60

                points[#points + 1] = {
                    Island = island,
                    Name = enemyName,
                    CFrame = CFrame.new(p1 + Vector3.new(0, 40, 0)),
                }
                points[#points + 1] = {
                    Island = island,
                    Name = enemyName,
                    CFrame = CFrame.new(p2 + Vector3.new(0, 40, 0)),
                }
            end
        end
    end

    return points
end

local function MagnetFindTarget()
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end

    local char = game.Players.LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local best, bestDist

    for _, mob in ipairs(enemies:GetChildren()) do
        local hum = mob:FindFirstChild("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if mob:IsA("Model")
            and mob:GetAttribute("MagnetEnemy") == true
            and hum and root and hum.Health > 0
        then
            local dist = hrp and (root.Position - hrp.Position).Magnitude or 0
            if not best or dist < bestDist then
                best = mob
                bestDist = dist
            end
        end
    end

    return best
end

local function MagnetTravel(point)
    if not point or typeof(point.CFrame) ~= "CFrame" then
        return false
    end

    local player = game.Players.LocalPlayer
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    -- Tween benar-benar menuju EnemySpawn + Y40.
    Tween(point.CFrame)

    -- Selama perjalanan, cek MagnetEnemy terus.
    -- Check interval kecil; tidak ada wait >= 1 detik.
    while _G.Auto_MagnetEvent do
        local target = MagnetFindTarget()
        if target then
            StopCurrentTween()
            return target
        end

        char = player.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        if (point.CFrame.Position - hrp.Position).Magnitude <= 12 then
            break
        end

        task.wait(0.05)
    end

    if not _G.Auto_MagnetEvent then
        return false
    end

    -- Sudah sampai scan point: kasih waktu render 1 detik.
    local started = tick()
    while _G.Auto_MagnetEvent and tick() - started < 1 do
        local target = MagnetFindTarget()
        if target then
            StopCurrentTween()
            return target
        end
        task.wait(0.05)
    end

    return MagnetFindTarget() or false
end

