    if not moment then
        Secret39.Waiting("remote:" .. tostring(item.Name), "Menunggu secret controller", item.Name .. " belum loaded. Menunggu client/server replication...")
        return nil, "not_loaded"
    end
    local args = table.pack(...)
    local ok, err = pcall(function()
        moment:FireServer(action, table.unpack(args, 1, args.n))
    end)
    if ok then return true end
    Secret39.Notify("fireerr:" .. tostring(item.Name) .. ":" .. tostring(action), "Remote belum siap", item.Name .. " gagal mengirim action '" .. tostring(action) .. "'. Akan retry.", 12)
