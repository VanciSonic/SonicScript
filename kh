Secret39.Move = function(cf, radius)
    radius = radius or 10
    if typeof(cf) ~= "CFrame" then
        Secret39.Notify("bad_move", "Target tidak valid", "CFrame target Secret tidak valid. Auto tidak menebak koordinat lain.", 20)
        return false
    end
    local stallCount = 0
    while Secret39.Enabled do
        local char, root = Secret39.GetChar()
        if not root then
            Secret39.Waiting("character", "Menunggu respawn", "Character belum siap. Auto 39 pause sementara lalu resume otomatis...")
            task.wait(1)
        else
            local distance = (root.Position - cf.Position).Magnitude
            if distance <= radius then
                Secret39.ClearWaiting()
                return true
            end
            Secret39.ClearWaiting()
            pcall(function() Tween(cf) end)
            local deadline = os.clock() + math.max(2, math.min(12, distance / 80))
            while Secret39.Enabled and os.clock() < deadline do
                local _, currentRoot = Secret39.GetChar()
                if currentRoot and (currentRoot.Position - cf.Position).Magnitude <= radius then
                    stallCount = 0
                    return true
                end
                task.wait(0.12)
            end
            stallCount += 1
            Secret39.Waiting(
                "move:" .. tostring(Secret39.Current and Secret39.Current.Name or "secret"),
                "Menunggu posisi",
                "Target belum tercapai. Tween belum mencapai posisi; Auto akan retry (percobaan " .. tostring(stallCount) .. ")."
            )
            task.wait(0.25)
        end
    end
    return false
end

