                pcall(function()
                    local priority = table.find(MultiFarmPriority, selectedMode) or 0
                    MultiFarmStatus:SetDesc("Running: " .. selectedMode .. " | Priority " .. tostring(priority))
                end)
            else
                MultiFarmApplyMode("None")
                pcall(function()
                    MultiFarmStatus:SetDesc("Waiting...")
                end)
            end
        end
    end)
end


