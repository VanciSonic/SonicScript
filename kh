            MultiFarmRefreshDropdowns()
            return
        end

        local oldValue = MultiFarmPriority[slot]
        local oldSlot

        for i = 1, MultiFarmSlotCount do
            if i ~= slot and MultiFarmPriority[i] == newValue then
                oldSlot = i
                break
            end
