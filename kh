    local IRS = require(game.ReplicatedStorage.ItemReplicationService)
    local ItemConfig = require(game.ReplicatedStorage.ItemConfig)
    -- Material, Accesorry, PhysicalMoveset, Title, Race, Ability, Moveset
    function GetMaterial(name, itemType)
        local items = IRS:GetItems("Quantity")
        name = string.lower(tostring(name))
        itemType = itemType and string.lower(tostring(itemType))

        for _, v in pairs(items) do
            if type(v) == "table" and v.ItemId then
                local ok, item = pcall(function()
                    return ItemConfig.match(v.ItemId):unwrap()
                end)

                if ok and item and item.Index then
                    local index = item.Index
                    local storageKey = string.lower(tostring(index.StorageKey or ""))
                    local idType = string.lower(tostring(index.IdType or ""))

                    if storageKey == name and (not itemType or idType == itemType) then
                        return tonumber(v.Value) or 0
                    end
                end
            end
        end

        return 0
    end

    local function CheckMaterials()
        local Bones = GetMaterial("Bones", "Material")
        local Ectoplasm = GetMaterial("Ectoplasm", "Material")
        local Fragments = GetMaterial("Fragments", "Material")
        local DarkFragment = GetMaterial("Dark Fragment", "Material")

        if Bones < 500 or Ectoplasm < 250 or Fragments < 5000 or DarkFragment < 1 then
            v14:Notify({
                Title = "Soul Guitar",
                Content = string.format(
                    "Material kurang | Bones %d/500 | Ectoplasm %d/250 | Fragments %d/5000 | Dark Fragment %d/1",
                    Bones, Ectoplasm, Fragments, DarkFragment
                ),
                Duration = 4
            })
            return false
        end

        return true
    end

