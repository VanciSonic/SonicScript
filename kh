function SmartTween(target)
    if typeof(target) ~= "CFrame" then return end
    if _G.StopTween then return end

    local character, humanoid, root = GetCharacter()
    if not character or not humanoid or not root or humanoid.Health <= 0 then return end

    local distance = (target.Position - root.Position).Magnitude

    if distance <= SMART_TWEEN_DISTANCE then
        return NormalTween(target)
    end

    if not _G.BypassTeleport then
        return NormalTween(target)
    end

    if _G.SafeItemProtection then
        local protected = HasSafeProtectedItem()
        if protected then
            return NormalTween(target)
        end
    end

    if SmartBypassBusy then return end

    local routeVersion = _G.BypassTeleportVersion or 0
    local bypassed = SmartBypass(target)

    -- IMPORTANT: after respawn, the toggle/version is checked again.
    -- If the user disabled Bypass Teleport during the death/respawn phase,
    -- this route MUST NOT start a normal tween automatically.
    if bypassed then
        if _G.BypassTeleport ~= true
            or (_G.BypassTeleportVersion or 0) ~= routeVersion
            or _G.SmartBypassCancelled == true
            or _G.StopTween
        then
            return
        end

        local _, newHumanoid, newRoot = GetCharacter()
        if not newHumanoid or not newRoot or newHumanoid.Health <= 0 then return end
        if _G.BypassTeleport ~= true
            or (_G.BypassTeleportVersion or 0) ~= routeVersion
            or _G.SmartBypassCancelled == true
            or _G.StopTween
        then
            return
        end

        if (target.Position - newRoot.Position).Magnitude > 8 then
            NormalTween(target)
        end
    elseif not _G.BypassTeleport
        or (_G.BypassTeleportVersion or 0) ~= routeVersion
        or _G.SmartBypassCancelled == true
        or _G.StopTween
    then
        return
    else
        -- Bypass failed while it was still enabled: normal fallback.
        NormalTween(target)
    end
end

