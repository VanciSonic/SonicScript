local function findQuestMobPos(mobName, origin)
    if not mobName then return nil end
    local base=origin or getPos()
    local low=string.lower(mobName)
    local best,bestD=nil,math.huge
    local enemies=workspace:FindFirstChild("Enemies")
    if enemies then
        for _,m in ipairs(enemies:GetChildren()) do
            if m:IsA("Model") then
                local h=m:FindFirstChildOfClass("Humanoid")
                local r=m:FindFirstChild("HumanoidRootPart")
                if h and r and h.Health>0 and string.lower(m.Name)==low then
                    local d=(r.Position-base).Magnitude
                    if d<bestD then bestD,best=d,r.Position end
                end
            end
        end
    end
    local spawns=workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("EnemySpawns")
    if spawns then
        for _,obj in ipairs(spawns:GetChildren()) do
            local n=string.lower(obj.Name)
            if not n:find("%[boss%]") and n:find(low,1,true) then
                local pos
                if obj:IsA("BasePart") then
                    pos=obj.Position
                elseif obj:IsA("Model") then
                    if obj.PrimaryPart then
                        pos=obj.PrimaryPart.Position
                    else
                        for _,d in ipairs(obj:GetDescendants()) do
                            if d:IsA("BasePart") then pos=d.Position break end
                        end
                    end
                end
                if pos then
                    local d=(pos-base).Magnitude
                    if d<bestD then bestD,best=d,pos end
                end
            end
        end
    end
