                    end

                    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(pos)

                    task.wait()
                until not _G.AutoBartilo
                    or (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - pos).Magnitude <= 1.5

                task.wait(0.2)
            end
        end
