Secret39.UsePrompt = function(prompt, radius, item, label)
    if not prompt or not prompt:IsA("ProximityPrompt") then
        if item then
            Secret39.Waiting("prompt:" .. tostring(item.Name) .. ":" .. Secret39.Normalize(label or "prompt"), "Menunggu interaction", (label or "Interaction") .. " belum muncul. Menunggu prompt dari map...")
        end
        return false
    end
    local parent = prompt.Parent
    local target = parent and parent:IsA("BasePart") and parent or nil
    if target then
        Secret39.Move(target.CFrame, radius or 12)
    else
        local model = prompt:FindFirstAncestorOfClass("Model")
        if model then
            Secret39.Move(model:GetPivot(), radius or 12)
        end
    end
    local fired = false
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
            fired = true
        end
    end)
    if not fired then
        Secret39.Notify("prompt_api", "Interaction belum tersedia", "Executor tidak menyediakan fireproximityprompt. Menunggu interaction yang tersedia.", 20)
    end
    return fired
end

Secret39.ChooseTool = function(kind)
    local plr = game:GetService("Players").LocalPlayer
    local char = plr.Character
    local bag = plr:FindFirstChildOfClass("Backpack")
    local containers = {char, bag}
    local wanted = kind
    for _, box in ipairs(containers) do
        if box then
            for _, tool in ipairs(box:GetChildren()) do
                if tool:IsA("Tool") then
                    local tip = tostring(tool.ToolTip or "")
                    local good = false
                    if wanted == "Fruit" then
                        good = tip == "Blox Fruit"
                    else
                        good = tip == wanted
                    end
                    if good then return tool end
                end
            end
        end
    end
    return nil
end

Secret39.Equip = function(kind, item)
    local tool = Secret39.ChooseTool(kind)
    if not tool then
        if item then
            Secret39.Waiting(
                "tool:" .. tostring(item.Name) .. ":" .. tostring(kind),
                "Menunggu tool",
                item.Name .. " membutuhkan tool tipe " .. tostring(kind) .. ". Tool belum tersedia/equipped; menunggu..."
            )
        end
        return nil
    end
    Secret39.ClearWaiting()
    local char = game:GetService("Players").LocalPlayer.Character
    if tool.Parent ~= char then
        pcall(function()
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum:EquipTool(tool) end
        end)
    end
    return tool
end

Secret39.HitPart = function(part, kind, seconds, item)
    if not part or not part:IsA("BasePart") then
        if item then
            Secret39.Waiting("target_part:" .. tostring(item.Name), "Menunggu target", item.Name .. " target belum berupa BasePart yang bisa diinteraksi. Menunggu map state...")
        end
        return false
    end
    local tool = Secret39.Equip(kind or "Sword", item)
    if not tool then
        return false
    end
    Secret39.Move(CFrame.lookAt(part.Position - part.CFrame.LookVector * 5 + Vector3.new(0,2,0), part.Position), 8)
    local started = os.clock()
    while Secret39.Enabled and os.clock() - started < (seconds or 1.5) do
        pcall(function() tool:Activate() end)
        task.wait(0.12)
    end
    return true
end

Secret39.FarmEnemies = function(patterns, duration, item, suppressWait)
    duration = duration or 20
    item = item or Secret39.Current
    local started = os.clock()
    local hit = false
    local warnedAt = 0
    local patternText = table.concat(patterns or {}, ", ")
    while Secret39.Enabled and os.clock() - started < duration do
        local enemies = workspace:FindFirstChild("Enemies")
        local found = false
        if enemies then
            for _, mob in ipairs(enemies:GetChildren()) do
                local hum = mob:FindFirstChildOfClass("Humanoid")
                local hrp = mob:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local n = Secret39.Normalize(mob.Name)
                    for _, pattern in ipairs(patterns or {}) do
                        if n:find(Secret39.Normalize(pattern), 1, true) then
                            found = true
                            hit = true
                            Secret39.ClearWaiting()
                            pcall(function()
                                local weapon = SelectWeapon
                                if not weapon or weapon == "" then
                                    local tool = Secret39.ChooseTool("Melee") or Secret39.ChooseTool("Sword")
                                    weapon = tool and tool.Name
                                end
                                if weapon and weapon ~= "" then
                                    AttackEnemies(mob.Name, mob, weapon, true)
                                else
                                    Secret39.Waiting(
                                        "farm_weapon:" .. Secret39.Normalize(item and item.Name or patternText),
                                        "Menunggu weapon",
                                        (item and item.Name or "Secret ini") .. " tidak menemukan weapon Melee/Sword untuk menyerang target."
                                    )
                                end
                            end)
                            break
                        end
                    end
                end
            end
        end
        if not found then
            if not suppressWait and os.clock() - started >= 2 and os.clock() - warnedAt >= 3 then
                warnedAt = os.clock()
                Secret39.Waiting(
                    "enemy:" .. Secret39.Normalize(item and item.Name or patternText),
                    "Menunggu target",
                    (item and item.Name or "Secret ini") .. " sedang menunggu target " .. (patternText ~= "" and patternText or "enemy") .. " spawn/aktif..."
                )
            end
            task.wait(0.25)
        end
    end
    return hit
end

Secret39.IsNight = function()
