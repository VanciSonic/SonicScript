local function FormatTime(sec)
    sec = math.max(0, math.floor(sec))
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = sec % 60

    if h > 0 then
        return string.format("%02d:%02d:%02d", h, m, s)
    end

    return string.format("%02d:%02d", m, s)
end

local function CheckRandomFruit()
    if not GachaClient then
        return false, "GachaClient tidak ditemukan", 0
    end

    local ok, data = pcall(function()
        return GachaClient.CheckGachaAsync(
            "ZiolesGacha",
            "Blox Fruit Gacha"
        )
    end)

    if not ok then
        return false, "Gagal cek status", 0
    end

    if type(data) ~= "table" then
        return false, "Data gacha invalid", 0
    end

    if data.Cooldown and data.Cooldown.RequirementMet == false then
        local ends = tonumber(data.Cooldown.TimeEnds) or 0
        local remaining = math.max(0, ends - os.time())

        if ends > 100000000000 then
            remaining = math.max(0, (ends / 1000) - os.time())
        end

        return false, "Cooldown", remaining
    end

    if data.Price and data.Price.RequirementMet == false then
        return false, "Beli tidak cukup", 0
    end

    return true, "Auto Roll", 0
end

