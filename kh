        -- =========================================================
        -- Island detect (closest Island N within range)
        -- =========================================================
        local function AutoFragmentIsIslandRaid(cu)
            local locs = AutoFragmentGetLocations()
            if not locs or not locs:FindFirstChild("Island " .. cu) then
                return nil
            end
            local hrp = AutoFragmentLP.Character and AutoFragmentLP.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end

            local min = 4500
            for _, v in ipairs(locs:GetChildren()) do
                if v.Name == "Island " .. cu then
                    local dist = (v.Position - hrp.Position).Magnitude
                    if dist < min then
                        min = dist
                    end
                end
            end

            for _, v in ipairs(locs:GetChildren()) do
                if v.Name == "Island " .. cu then
                    local dist = (v.Position - hrp.Position).Magnitude
                    if dist <= min then
                        return v
                    end
                end
            end
            return nil
        end

        -- Island stage tetap 1 → 5. Untuk setiap ID, ambil instance yang paling dekat.
        local function AutoFragmentGetIslandById(id, maxDistance)
            local hrp = AutoFragmentLP.Character and AutoFragmentLP.Character:FindFirstChild("HumanoidRootPart")
            local locs = AutoFragmentGetLocations()
            if not hrp or not locs then return nil end

            maxDistance = maxDistance or 4500
            local nearest, nearestDist = nil, math.huge
            for _, v in ipairs(locs:GetChildren()) do
                if v.Name == "Island " .. tostring(id) then
                    local dist = (v.Position - hrp.Position).Magnitude
                    if dist <= maxDistance and dist < nearestDist then
                        nearest = v
                        nearestDist = dist
                    end
                end
            end
            return nearest, nearestDist
        end

        local function AutoFragmentGetNextIsland()
            for id = 1, 5 do
                local island = AutoFragmentGetIslandById(id, 4500)
                if island then
                    return island, id
                end
            end
            return nil
        end

        function AutoFragmentWaitAnyRaidIsland(timeout)
            timeout = timeout or 60
            local t = tick() + timeout
            while AutoFragmentRunning and tick() < t do
                local island, id = AutoFragmentGetNextIsland()
                if island then
                    return island, id
                end
                -- fallback: any Island 1..5 exists in Locations
                local locs = AutoFragmentGetLocations()
                if locs then
                    for id = 1, 5 do
                        local v = locs:FindFirstChild("Island " .. id)
                        if v then
                            return v, id
                        end
                    end
                end
                task.wait(0.25)
            end
            return nil
        end

        -- After start: wait until player is near a raid island (teleport/load selesai)
        function AutoFragmentWaitPlayerNearRaidIsland(timeout)
            timeout = timeout or 60
            local t = tick() + timeout
            while AutoFragmentRunning and tick() < t do
                local hrp = AutoFragmentLP.Character and AutoFragmentLP.Character:FindFirstChild("HumanoidRootPart")
                local locs = AutoFragmentGetLocations()
                if hrp and locs then
                    for id = 1, 5 do
                        for _, v in ipairs(locs:GetChildren()) do
                            if v.Name == "Island " .. id then
                                local dist = (v.Position - hrp.Position).Magnitude
                                -- player sudah masuk zona island raid
                                if dist <= 2500 then
                                    return v, id
                                end
                            end
                        end
                    end
                end
                task.wait(0.3)
            end
            return nil
        end

        local function AutoFragmentFindRaidMob()
            local hrp = AutoFragmentLP.Character and AutoFragmentLP.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end
            local enemies = workspace:FindFirstChild("Enemies")
            if not enemies then return nil end

            local best, bestD = nil, math.huge
            for _, enemy in ipairs(enemies:GetChildren()) do
                local hum = enemy:FindFirstChildOfClass("Humanoid")
                local root = enemy:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    local d = (root.Position - hrp.Position).Magnitude
                    -- prioritas mob di zona island raid
                    if d <= 4500 and d < bestD then
                        bestD = d
                        best = enemy
                    end
                end
            end
            return best
        end

        local function AutoFragmentFindRaidMobForIsland(island)
            if not island then return nil end
            local enemies = workspace:FindFirstChild("Enemies")
            if not enemies then return nil end

            local best, bestD = nil, math.huge
            for _, enemy in ipairs(enemies:GetChildren()) do
                local hum = enemy:FindFirstChildOfClass("Humanoid")
                local root = enemy:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    local d = (root.Position - island.Position).Magnitude
                    if d <= 1200 and d < bestD then
                        best = enemy
                        bestD = d
                    end
                end
            end
            return best
        end

        local function AutoFragmentFarmIslands()
            _G.AutoNear = false
            AutoNextIsland = false

            if not AutoFragmentInRaid or not AutoFragmentRaidActive() then
                AutoFragmentStopInstant()
                return
            end

            for islandId = 1, 5 do
                if not AutoFragmentRunning or not AutoFragmentInRaid then break end

                if not AutoFragmentRaidActive() then
                    AutoFragmentStopInstant()
                    return
                end

                AutoFragmentStatus:SetDesc("Waiting Island " .. tostring(islandId) .. "...")
                local island = nil
                local deadline = tick() + 20

                while AutoFragmentRunning and AutoFragmentInRaid and tick() < deadline do
                    if not AutoFragmentRaidActive() then
                        AutoFragmentStopInstant()
                        return
                    end
                    island = AutoFragmentGetIslandById(islandId, 4500)
                    if island then break end
                    task.wait(0.15)
                end

                if not island then
                    AutoFragmentStatus:SetDesc("Island " .. tostring(islandId) .. " not loaded — retry...")
                    return
                end

                AutoFragmentStatus:SetDesc("Island " .. tostring(islandId) .. " — AttackEnemies")

                while AutoFragmentRunning and AutoFragmentInRaid do
                    if not AutoFragmentRaidActive() then
                        AutoFragmentStopInstant()
                        return
                    end

                    local currentIsland = AutoFragmentGetIslandById(islandId, 4500) or island
                    local mob = AutoFragmentFindRaidMobForIsland(currentIsland)

                    if not mob then
                        pcall(function()
                            Tween(currentIsland.CFrame * CFrame.new(0, 40, 0))
                        end)
                        task.wait(0.2)
                    else
                        pcall(function()
                            AttackEnemies(mob.Name, mob, SelectWeapon, false)
                        end)
                        task.wait(0.08)
                    end

                    if not AutoFragmentFindRaidMobForIsland(currentIsland) then
                        break
                    end
                end
            end

            while AutoFragmentRunning and AutoFragmentInRaid do
                if not AutoFragmentRaidActive() then
                    AutoFragmentStopInstant()
                    break
                end
                task.wait(0.05)
            end

            if AutoFragmentRunning and not AutoFragmentInRaid then
                AutoFragmentStatus:SetDesc("RaidTimer false — STOP tween, waiting return...")
                AutoFragmentStopAfterRaid()
            end
        end

        local AutoFragmentSection = v16.Raid:AddSection("Auto Farm Fragment")
        AutoFragmentSection:AddParagraph({
            Title = "Fruit Sacrifice",
            Content = "Pilih PhysicalMoveset fruit yang mau dikorbankan untuk Auto Raid."
        })

        -- IMPORTANT:
        -- Jangan panggil AutoFragmentGetPhysicalFruits() langsung di argumen AddDropdown.
        -- Pada beberapa executor/thread context, ItemReplicationService/ItemConfig dapat
        -- melempar: "The current thread cannot access Instance" saat UI sedang dibuat.
        -- Dropdown dibuat kosong dulu, lalu inventory dibaca setelah UI selesai dibuat.
        AutoFragmentFruitDropdown = AutoFragmentSection:AddDropdown("AutoFragmentFruit", {
            Title = "Select Fruit",
            Description = "Multi-select fruit inventory",
            Values = {},
            Multi = true,
            Default = {}
        })
        AutoFragmentFruitDropdown:OnChanged(function(value)
            AutoFragmentSelectedFruits = {}
            local function mark(fruit)
                fruit = AutoFragmentStripQty(fruit)
                if fruit ~= "" and fruit ~= "(No Physical Fruit)" then
                    AutoFragmentSelectedFruits[fruit] = true
                end
            end
            if type(value) == "table" then
                for fruit, enabled in pairs(value) do
                    if enabled == true then
                        mark(fruit)
                    elseif type(fruit) == "number" and type(enabled) == "string" then
                        mark(enabled)
                    end
                end
            elseif type(value) == "string" then
                mark(value)
            end
        end)

        -- Read PhysicalMoveset only after the dropdown/UI has been constructed.
        -- pcall prevents the whole hub from stopping if the executor rejects an Instance
        -- access from this scheduler context. The manual Refresh button uses the same safe path.
        task.defer(function()
            if not AutoFragmentFruitDropdown then return end
            pcall(function()
                AutoFragmentRefreshFruitDropdown()
            end)
        end)

        AutoFragmentSection:AddButton({
            Title = "Refresh Fruit List",
            Description = "Refresh PhysicalMoveset dari inventory",
            Callback = function()
                AutoFragmentRefreshFruitDropdown()
            end
        })

        AutoFragmentRaidDropdown = AutoFragmentSection:AddDropdown("AutoFragmentRaid", {
            Title = "Select Raid",
            Description = "Raid yang akan dijalankan",
            Values = AutoFragmentRaidList,
