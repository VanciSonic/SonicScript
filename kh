Secret39.WaitActive = function(item, message)
    while Secret39.Enabled do
        local m = Secret39.GetLoaded(item.Name)
        if m then
            if m.Completed then return m end
            if m.Active then
                Secret39.ClearWaiting()
                return m
            end
        end
        Secret39.Waiting("active:"..item.Name, "Menunggu secret aktif", message or ("Menunggu "..item.Name.." aktif..."))
        task.wait(1)
    end
end

Secret39.VerifyComplete = function(item, timeout)
    local started = os.clock()
    timeout = timeout or 12
    while Secret39.Enabled and os.clock() - started <= timeout do
        local progress = Secret39.GetProgress()
        if progress and Secret39.IsComplete(item, progress) then
            Secret39.ClearWaiting()
            return true
        end
        if not progress then
            Secret39.Waiting("verify_progress:" .. tostring(item.Name), "Menunggu server", item.Name .. " belum bisa membaca progress server. Menunggu replication...")
        else
            Secret39.Waiting("verify_complete:" .. tostring(item.Name), "Menunggu completion", item.Name .. " belum dikonfirmasi selesai oleh server. Menunggu save/progress update...")
        end
        task.wait(0.7)
    end
    return false
end

Secret39.Awakened = function(item, bossPatterns, preAction)
    while Secret39.Enabled do
        local m = Secret39.GetLoaded(item.Name)
        if not m or not m.Active then
