function BuyFightingStyle(styleName)
    task.spawn(function()
        if HasFightingStyle(styleName) then
            makeNotify({Title = "Auto Buy", Content = "✅ " .. styleName .. " sudah dimiliki!", Duration = 4})
            return
        end

        local data = FightingStyles[styleName]
        if not data then
            makeNotify({Title = "Error", Content = "❌ Data " .. styleName .. " tidak ditemukan!", Duration = 4})
            return
        end

        local currentWorld = 1
        if World2 then
            currentWorld = 2
        elseif World3 then
            currentWorld = 3
        end

        local targetPos = data.Pos[currentWorld]
        if not targetPos then
            makeNotify({Title = "Error", Content = "❌ " .. styleName .. " tidak tersedia di Sea " .. currentWorld, Duration = 4})
            return
        end

        local targetCFrame = CFrame.new(targetPos)

        while true do
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if not hrp then
                makeNotify({Title = "Auto Buy", Content = "❌ Karakter hilang!", Duration = 4})
                return
