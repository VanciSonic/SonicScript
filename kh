Secret39.Call = function(item, action, ...)
    local moment = Secret39.GetLoaded(item.Name)
    if not moment then
        Secret39.Waiting("remote:" .. tostring(item.Name), "Menunggu secret controller", item.Name .. " belum loaded. Menunggu client/server replication...")
        return nil, "not_loaded"
    end
    local args = table.pack(...)
    local ok, a, b, c, d = pcall(function()
        return moment:InvokeServer(action, table.unpack(args, 1, args.n))
    end)
    if not ok then
        Secret39.Notify("callerr:" .. tostring(item.Name) .. ":" .. tostring(action), "Remote belum siap", item.Name .. " gagal menjalankan action '" .. tostring(action) .. "'. Akan retry saat state siap.", 12)
        return nil, a
    end
    return a, b, c, d
end

