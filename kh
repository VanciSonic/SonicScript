local function FindFarmTarget()
    local enemies=workspace:FindFirstChild("Enemies")
    if not enemies then return end
    local char=game.Players.LocalPlayer.Character
    local hrp=char and char:FindFirstChild("HumanoidRootPart")

    if TypeMastery=="Farm Level" then
        CheckQuestMob()
        if not NameMon then return end
        for _,v in ipairs(enemies:GetChildren()) do
            local h=v:FindFirstChild("Humanoid")
            local r=v:FindFirstChild("HumanoidRootPart")
            if v.Name==NameMon and h and r and h.Health>0 then return v end
        end

    elseif TypeMastery=="Near Mobs" and hrp then
        local target,dist=nil,math.huge
        for _,v in ipairs(enemies:GetChildren()) do
            local h=v:FindFirstChild("Humanoid")
            local r=v:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health>0 then
                local d=(r.Position-hrp.Position).Magnitude
                if d<=5000 and d<dist then
                    target,dist=v,d
                end
            end
        end
        return target
    elseif TypeMastery=="Boss" then
        local bossList = FarmTargetLists.Boss
        local rs = game:GetService("ReplicatedStorage")
        if bossList then
            for _, bossName in ipairs(bossList) do
                for _, v in ipairs(rs:GetChildren()) do
                    local h = v:FindFirstChildOfClass("Humanoid")
                    local r = v:FindFirstChild("HumanoidRootPart")
                    if v.Name == bossName and h and r and h.Health > 0 then
                        return v
                    end
                end
                if enemies then
                    for _, v in ipairs(enemies:GetChildren()) do
                        local h = v:FindFirstChildOfClass("Humanoid")
                        local r = v:FindFirstChild("HumanoidRootPart")
                        if v.Name == bossName and h and r and h.Health > 0 then
                            return v
                        end
                    end
                end
            end
        end
    else
        local list=FarmTargetLists[TypeMastery]
        if list then
            for _,v in ipairs(enemies:GetChildren()) do
                local h=v:FindFirstChild("Humanoid")
                local r=v:FindFirstChild("HumanoidRootPart")
                if table.find(list,v.Name) and h and r and h.Health>0 then return v end
            end
        end
    end
end
