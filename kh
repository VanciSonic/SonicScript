                    local count = tonumber(entry.Value) or 0
                    if count > 0 then
                        local okItem, item = pcall(function()
                            return AutoFragmentItemConfig.match(entry.ItemId):unwrap()
                        end)
                        if okItem and item and item.Index then
                            local index = item.Index
                            local idType = string.lower(tostring(index.IdType or ""))
                            -- Physical fruit only
