function attackGun(targetCFrame)
    if typeof(targetCFrame) ~= "CFrame" then
        warn("[attackGun] Argumen harus CFrame")
        return false
    end

    local char = LocalPlayer.Character
    if not char then return false end

    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        return false
    end

    local weaponName = CombatUtil:GetWeaponName(tool)
    local weaponData = CombatUtil:GetWeaponData(weaponName)
    if not weaponData or weaponData.WeaponType ~= "Gun" then
        return false
    end

    if tool:GetAttribute("IsReloading_Client") then
        return false
    end
    if (tool:GetAttribute("LocalShotsLeft") or 0) < 1 then
        return false
    end
    forcedTarget = targetCFrame
    CombatController:Attack(tool, {
        UserInputType = Enum.UserInputType.MouseButton1,
        UserInputState = Enum.UserInputState.Begin
    })

    task.delay(0.05, function()
        forcedTarget = nil
    end)

    return true
end

