function makeNotify(cfg)
    cfg = cfg or {}
    if Ghub and Ghub.MakeNotify then
        Ghub:MakeNotify({
            Title = cfg.Title or "Ganteng Hub",
            Description = cfg.Description or "Info",
            Content = cfg.Content or cfg.Description or "",
            Color = cfg.Color or Color3.fromRGB(160, 160, 160),
            Time = 0.5,
            Delay = cfg.Duration or cfg.Delay or 5
        })
    elseif type(rcchub) == "function" then
        rcchub(cfg.Content or cfg.Description or "Notify", cfg.Duration or 4, cfg.Color, cfg.Title, cfg.Description)
    end
end

