function GetItemCount(targetName)
    targetName = CleanName(targetName)

    local player = Players.LocalPlayer

    local cache = ItemReplicationService._UserCache[player.UserId]

    if not cache then
        warn("Inventory cache tidak ditemukan")
        return 0
    end

    local items = cache:GetItems("Quantity")

    if type(items) ~= "table" then
        warn("GetItems('Quantity') bukan table:", typeof(items))
        return 0
    end

    for _, itemEntry in pairs(items) do
        if type(itemEntry) == "table" and itemEntry.ItemId then

            local ok, item = pcall(function()
                return ItemConfig.match(itemEntry.ItemId):unwrap()
            end)

            if ok and item and item.Index then

                local debugLabel = item.Index.DebugLabel

                if CleanName(debugLabel):find(targetName, 1, true) then
                    return tonumber(itemEntry.Value) or 0
                end
            end
        end
    end

    return 0
end
