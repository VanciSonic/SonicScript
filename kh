local function GetBossRoot(model)
    if not model then return nil end
    local root = model:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then
        return root
    end
    return nil
end

local function GetBossHumanoid(model)
    if not model then return nil end
    return model:FindFirstChildOfClass("Humanoid")
end

local function FindLiveBoss(name)
    local enemies = game:GetService("Workspace"):FindFirstChild("Enemies")
    if not enemies or not name then return nil end

    local boss = enemies:FindFirstChild(name)
    if boss then
        local hum = GetBossHumanoid(boss)
        local root = GetBossRoot(boss)
        if hum and root and hum.Health > 0 then
            return boss
        end
    end
    return nil
end

-- ReplicatedStorage is used as the boss spawn/template source.
-- Workspace.Enemies is used only after the boss has actually spawned,
-- so AttackEnemies receives the live target.
local function FindReplicatedBoss(name)
    if not name then return nil end
    local boss = game:GetService("ReplicatedStorage"):FindFirstChild(name)
    if boss then
        local root = GetBossRoot(boss)
        if root then
            return boss
        end
    end
    return nil
end

