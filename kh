Secret39.Handlers.Fishman = function(item)
    local m = Secret39.WaitActive(item)
    if not m then return false end
    pcall(function() Secret39.Call(item, "Initialize") end)
    local state = m.MiscData and m.MiscData._fishmanKarateState
    if not state or not state.instance then
        Secret39.Waiting("fishman_setup", "Menunggu puzzle", "Fishman Karate puzzle belum selesai setup. Menunggu state...")
        task.wait(1)
        return false
    end
    local inst = state.instance
    local function solvePillar(index, tx, ty)
        local pillar = inst:FindFirstChild("Pillar"..tostring(index), true)
        if not pillar then
            Secret39.Waiting("fishman_pillar:" .. item.Name .. ":" .. tostring(index), "Menunggu pillar", "Fishman Karate Pillar " .. tostring(index) .. " belum muncul. Menunggu puzzle setup...")
            task.wait(0.7)
            return false
        end
        local root = pillar.PrimaryPart or pillar:FindFirstChildWhichIsA("BasePart", true)
        if not root then
            Secret39.Waiting("fishman_root:" .. item.Name .. ":" .. tostring(index), "Menunggu pillar", "Fishman Karate Pillar " .. tostring(index) .. " belum punya root. Menunggu asset...")
            task.wait(0.7)
            return false
        end
        local guard = 0
        while Secret39.Enabled and guard < 60 do
            local px = tonumber(pillar:GetAttribute("PositionX") or pillar:GetAttribute("X") or root:GetAttribute("PositionX")) or 0
            local py = tonumber(pillar:GetAttribute("PositionY") or pillar:GetAttribute("Y") or root:GetAttribute("PositionY")) or 0
            if px == tx and py == ty then return true end
            local side
            if px < tx then side = CFrame.new(-12,0,0)
            elseif px > tx then side = CFrame.new(12,0,0)
            elseif py < ty then side = CFrame.new(0,0,-12)
            else side = CFrame.new(0,0,12) end
            Secret39.Move(root.CFrame * side, 10)
            task.wait(0.25)
            guard += 1
        end
        return false
    end
    if not solvePillar(3, 1, 2) then return false end
    if not solvePillar(4, 4, 2) then return false end
    return Secret39.VerifyComplete(item, 8)
end

