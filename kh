function GetQuestForMob(mobName, playerLevel)
    local bestQuest
    local bestKey
    local bestIndex

    if not mobName then
        return nil, nil, nil
    end

    local blocked = {
        BartiloQuest = true,
        CitizenQuest = true
    }

    for questKey, questList in pairs(Quests) do
        if not blocked[questKey] and type(questList) == "table" then
            for index, quest in ipairs(questList) do
                if type(quest) == "table"
                    and type(quest.LevelReq) == "number"
                    and quest.LevelReq <= playerLevel
                    and type(quest.Task) == "table"
                    and not isBossQuest(quest)
                    and quest.Task[mobName]
                then
                    if not bestQuest
                        or quest.LevelReq > bestQuest.LevelReq
                    then
                        bestQuest = quest
                        bestKey = questKey
                        bestIndex = index
                    end
                end
            end
        end
    end

    return bestQuest, bestKey, bestIndex
end
