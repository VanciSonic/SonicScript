Secret39.Handlers.FrozenDefense = function(item)
    local m = Secret39.WaitActive(item, item.EventText or "Menunggu Frozen Defense / cursed Yeti event...")
    if not m then return false end

    -- The client module initializes its own rock/torch state with Init.
    pcall(function() Secret39.Fire(item, "Init") end)
    task.wait(0.35)

    local plr = game:GetService("Players").LocalPlayer
    if plr:GetAttribute("FrozenDefenseYetiDefeated") == true then
        return Secret39.VerifyComplete(item, 6)
    end

    local map = workspace:FindFirstChild("Map")
    local ice = map and map:FindFirstChild("Ice")
    local locations = ice and ice:FindFirstChild("BonusMoment_Locations", true)
    if not locations and map then
        locations = map:FindFirstChild("BonusMoment_Locations", true)
    end

    if not locations then
        Secret39.Waiting("frozen_locations:" .. item.Name, "Menunggu Frozen Defense map", "BonusMoment_Locations belum loaded. Menunggu Ice map/replication...")
        task.wait(1)
        return false
    end

    local rocks = {}
    for _, obj in ipairs(locations:GetChildren()) do
        if obj.Name == "iceRock" and obj:IsA("BasePart") then
            if obj:GetAttribute("FrozenDefenseRockPresent") ~= false then
                table.insert(rocks, obj)
            end
        end
    end

    table.sort(rocks, function(a, b)
        local ap, bp = a.Position, b.Position
        local dx = math.abs(ap.X - bp.X)
        if dx > 0.001 then return ap.X < bp.X end
        return ap.Z < bp.Z
    end)

    if #rocks == 0 then
        Secret39.Waiting("frozen_rocks:" .. item.Name, "Menunggu ice rocks", "Semua iceRock target belum muncul/masih diproses. Menunggu Frozen Defense state...")
        task.wait(1)
        return false
    end

    local tool = Secret39.Equip("Sword", item) or Secret39.Equip("Melee", item)
    if not tool then return false end

    for index, rock in ipairs(rocks) do
        if not Secret39.Enabled then return false end
        if not rock.Parent or rock:GetAttribute("FrozenDefenseRockPresent") == false then
            continue
        end

        Secret39.Status(("Frozen Defense — menghancurkan ice rock %d/%d"):format(index, #rocks))
        Secret39.Move(
            CFrame.lookAt(rock.Position - Vector3.new(0, 0, 7), rock.Position),
            10
        )

        local started = os.clock()
        while Secret39.Enabled and rock.Parent and rock:GetAttribute("FrozenDefenseRockPresent") ~= false and os.clock() - started < 8 do
            pcall(function() tool:Activate() end)
            task.wait(0.12)
        end

        if rock.Parent and rock:GetAttribute("FrozenDefenseRockPresent") ~= false then
            Secret39.Waiting(
                "frozen_rock_refused:" .. item.Name .. ":" .. tostring(index),
                "Menunggu ice rock",
                "Ice rock " .. tostring(index) .. " belum hancur. Menunggu hit/server state berikutnya..."
            )
            task.wait(0.8)
        else
            Secret39.ClearWaiting()
        end
    end

    if plr:GetAttribute("FrozenDefenseYetiDefeated") ~= true then
        Secret39.Waiting("frozen_yeti:" .. item.Name, "Menunggu cursed Yeti", "Ice sequence selesai/berjalan. Menunggu BossAwakening dan cursed Yeti spawn...")
        Secret39.FarmEnemies({"Cursed Yeti", "Awakened Yeti", "Yeti"}, 8, item, true)
    end

    if plr:GetAttribute("FrozenDefenseYetiDefeated") == true then
        return Secret39.VerifyComplete(item, 8)
    end
    return Secret39.VerifyComplete(item, 5)
end

