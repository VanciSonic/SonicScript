    return false
end

Secret39.Dispatch = function(item)
    local fn = Secret39.Handlers[item.Handler]
    if not fn then return Secret39.Handlers.BugStop(item) end
    local ok, result = pcall(fn, item)
    if not ok then
        Secret39.LastError = tostring(result)
        Secret39.Notify("error:"..item.Name, "Secret error", item.Name.." error: "..tostring(result), 10)
        return false
    end
    if result ~= true and Secret39.Enabled and Secret39.WaitingKey == nil then
        Secret39.Waiting("dispatch_retry:" .. item.Name, "Menunggu progress", item.Name .. " belum selesai. Tidak ada completion dari server; auto akan retry.")
    end
    return result == true
end

Secret39.NextItem = function(progress, islandName)
    islandName = islandName or Secret39.SelectedIsland
    for _, item in ipairs(Secret39.GetIslandItems(islandName)) do
        if not Secret39.IsComplete(item, progress) then
            return item
        end
    end
end

Secret39.CountDone = function(progress, islandName)
    return Secret39.GetIslandDone(progress, islandName or Secret39.SelectedIsland)
end

Secret39.Run = function()
    if not Secret39.Enabled or Secret39.Busy then return end
    if not World1 then
        Secret39.Notify("world1_only", "Auto Secret Quest", "Feature ini hanya untuk First Sea.", 15)
        Secret39.Status("⚠️ First Sea required")
        return
    end

    local selectedIsland = Secret39.SelectedIsland
    local islandItems = Secret39.GetIslandItems(selectedIsland)
    local total = #islandItems
    if total == 0 then
        Secret39.Notify("no_island_items", "Secret Quest", "Tidak ada data secret untuk island " .. tostring(selectedIsland) .. ".", 15)
        Secret39.Status("⚠️ Data secret island tidak ditemukan")
        return
    end

    Secret39.Busy = true
    local myToken = Secret39.Token
    Secret39.Status("Scanning progress " .. selectedIsland .. "...")

    local progress = Secret39.GetProgress()
    if not progress then
        Secret39.Busy = false
        Secret39.Waiting("progress", "Menunggu progress", "GetMomentProgress belum merespons. Menunggu server...")
        return
    end

    Secret39.ProgressData = progress
    Secret39.LastProgress = progress

    local done = Secret39.CountDone(progress, selectedIsland)
    Secret39.Status(("Progress %s: %d / %d ⭐"):format(selectedIsland, done, total))

    if done >= total then
        Secret39.Status(("✅ %s FULL STAR — %d/%d ⭐"):format(selectedIsland, done, total))
        Secret39.Notify(
            "island_done:" .. selectedIsland,
            "Secret Island selesai",
            ("✅ %s sudah full star (%d/%d). Auto dihentikan."):format(selectedIsland, done, total),
            0
        )
        Secret39.StopAuto()
        return
    end

    local item = Secret39.NextItem(progress, selectedIsland)
    if not item then
        Secret39.Busy = false
        return
    end

    local announced = Secret39.StartAnnounced[item.Name]
    local signature = tostring(done) .. ":" .. tostring(selectedIsland)
    if announced ~= signature then
        Secret39.StartAnnounced[item.Name] = signature
        Secret39.Notify(
            "start:" .. item.Name,
            "Auto Secret Quest",
            ("Mulai %d/%d: %s (%s)"):format(done + 1, total, item.Name, selectedIsland),
            0
        )
    end

    Secret39.Current = item
    Secret39.Status(("▶ %s — %d/%d"):format(item.Name, done + 1, total))

    if item.Bugged then
        Secret39.Notify(
            "bugged:" .. item.Name,
            item.Name,
            "Secret ini terdeteksi punya indikasi bug di source. Script akan mencoba target valid; tidak akan fake-complete.",
            20
        )
    end
    if item.Event then
        Secret39.Notify(
            "event_hint:" .. item.Name,
            "Event requirement",
            item.EventText or (item.Name .. " menunggu event/availability tertentu."),
            30
        )
    end
    if item.Night then
        Secret39.Notify(
            "night_hint:" .. item.Name,
            "Time requirement",
            item.Name .. " membutuhkan kondisi malam. Script akan menunggu otomatis.",
            30
        )
    end

    Secret39.ClearWaiting()
    Secret39.Move(item.CF, 20)
    if myToken ~= Secret39.Token or not Secret39.Enabled then
        Secret39.Busy = false
        return
    end

    local success = Secret39.Dispatch(item)
    if success and Secret39.VerifyComplete(item, 12) then
        Secret39.ClearWaiting()
        local newProgress = Secret39.GetProgress()
        if newProgress then
            Secret39.ProgressData = newProgress
            Secret39.LastProgress = newProgress
        end
        local newDone = Secret39.CountDone(Secret39.ProgressData or progress, selectedIsland)
        Secret39.Status(("✅ %d/%d — %s"):format(newDone, total, item.Name))
        Secret39.Notify(
            "done:" .. item.Name,
            "Secret selesai",
            ("✅ %s — %s progress %d/%d ⭐"):format(item.Name, selectedIsland, newDone, total),
            5
        )
        Secret39.StartAnnounced[item.Name] = nil

        if newDone >= total then
            Secret39.Status(("✅ %s FULL STAR — %d/%d ⭐"):format(selectedIsland, newDone, total))
            Secret39.Notify(
                "island_done:" .. selectedIsland,
                "Secret Island selesai",
                ("✅ %s sudah full star (%d/%d). Auto dihentikan."):format(selectedIsland, newDone, total),
                0
            )
            Secret39.StopAuto()
        end
    elseif Secret39.Enabled and Secret39.WaitingKey == nil then
        Secret39.Waiting(
            "retry:" .. item.Name,
            "Menunggu progress",
            item.Name .. " belum terkonfirmasi selesai. Auto akan retry sampai server mengubah progress."
        )
    end

    Secret39.Busy = false
end

