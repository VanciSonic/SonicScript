function FluentFacade:CreateWindow(cfg)
    cfg = cfg or {}
    local win = Ghub:Window({
        Title = cfg.Title or "Ganteng Hub Premium 〢",
        Footer = (_G.infoXXX.Name or "Game") .. " - " .. tanggal,
        Image = cfg.Image or "15006559003",
        Color = cfg.Color or Color3.fromRGB(160, 160, 160),
        Theme = cfg.Theme or 9542022979,
        Version = cfg.Version or 4,
        ["Tab Width"] = cfg.TabWidth or 130
    })

    if win then
        makeNotify({
            Title = "Ganteng Hub",
            Description = "Loading",
            Content = "Loading Script, Please Wait...",
            Duration = 4
        })
    end

    local selfRef = FluentFacade
    local WindowProxy = {}

    -- icon map for old tab titles
    local iconMap = {
        INFO = "idea",
        Main = "sword",
        ["Sea Event"] = "fish",
        ["Item & Quest"] = "scroll",
        Setting = "settings",
        ["Server Status"] = "web",
        Stats = "stat",
        Player = "player",
        Teleport = "gps",
        ["Visual Data"] = "eyes",
        Fruit = "bag",
        Raid = "boss",
        ["Race V4"] = "skeleton",
        Esp = "scan",
        Shop = "shop",
        Misc = "menu",
        ["Draco & Dragon Dojo"] = "dragon",
    }

    function WindowProxy:AddTab(tabCfg)
        tabCfg = tabCfg or {}
        local tabName = tabCfg.Title or tabCfg.Name or "Tab"
        local icon = tabCfg.Icon or iconMap[tabName] or "menu"
        local tab = win:AddTab({ Name = tabName, Icon = icon })
        -- NO auto section — only manual TabProxy:AddSection(...)
        local currentSection = nil
        local TabProxy = {}

        local function sec()
            if not currentSection then
                error("[Ganteng Hub] AddSection(...) dulu sebelum AddToggle/AddButton di tab: " .. tostring(tabName))
            end
            return currentSection
        end

        function TabProxy:AddSection(title, alwaysOpen)
            currentSection = tab:AddSection(tostring(title or "Section"), alwaysOpen)
            return TabProxy
        end

        function TabProxy:AddToggle(nameOrCfg, cfg)
            local opts, optKey
            if type(nameOrCfg) == "string" then
                optKey = nameOrCfg
                opts = cfg or {}
                opts.Title = opts.Title or nameOrCfg
            else
                opts = nameOrCfg or {}
                optKey = opts.Title or opts.Flag or ("T" .. math.random(1000, 9999))
            end

            local title = opts.Title or optKey
            local content = opts.Description or opts.Content or ""
            local default = opts.Default == true
            getgenv().GantengActiveToggles = getgenv().GantengActiveToggles or {}

            -- cbHolder: OnChanged user
            -- firing: cegah double-fire (Kaizen Callback + SetValue manual)
            local cbHolder = { fn = nil }
            local suppress = false

            local function fireUser(v)
                if suppress then return end
                if type(cbHolder.fn) ~= "function" then return end
                suppress = true
                pcall(cbHolder.fn, v)
                suppress = false
            end

            local userCbFromCfg = opts.Callback

            local toggleObj = sec():AddToggle({
                Title = title,
                Content = content,
                Default = default,
                Callback = function(v)
                    fireUser(v)
                end
            })

            local proxy = {}

            -- Fluent-style: daftar callback; jika UI sudah ON (default/config), sync ke _G sekali
            local function bindChanged(cb)
                cbHolder.fn = cb
                if type(cb) == "function" and toggleObj then
                    local cur = toggleObj.Value
                    if cur == true then
                        -- UI ON tapi _G mungkin masih false → paksa sync (mirip Fluent config load)
                        pcall(cb, true)
                    end
                end
                return proxy
            end

            -- support Callback di config (Fluent-style + Kaizen native)
            if type(userCbFromCfg) == "function" then
                bindChanged(userCbFromCfg)
            end

            function proxy:OnChanged(cb)
                return bindChanged(cb)
            end
            proxy.OnChanged = function(a, b)
                local cb = (type(a) == "function" and a) or b
                if type(a) == "table" then cb = b end
                return bindChanged(cb)
            end

            -- SetValue(v)        → update UI + jalankan OnChanged (Fluent)
            -- SetValue(v, true)  → update UI saja, tidak jalanin farm (init/config)
            function proxy:SetValue(v, silent)
                if not toggleObj or not toggleObj.Set then return end
                v = (v == true)
                if silent then
                    suppress = true
                    pcall(function()
                        if toggleObj.Set then toggleObj:Set(v, true) end
                    end)
                    suppress = false
                else
                    -- visual dulu (silent ke Kaizen), lalu fire user 1x — hindari double
                    suppress = true
                    pcall(function()
                        if toggleObj.Set then toggleObj:Set(v) end
                    end)
                    suppress = false
                    fireUser(v)
                end
            end

            function proxy:Set(v, silent)
                self:SetValue(v, silent)
            end

            function proxy:GetValue()
                return toggleObj and toggleObj.Value
            end

            proxy.__ActiveTitle = title
            table.insert(getgenv().GantengActiveToggles, proxy)
            selfRef.Options[optKey] = proxy
            selfRef.Options[title] = proxy
            return proxy
        end

        function TabProxy:AddButton(cfg)
            cfg = cfg or {}
            sec():AddButton({
                Title = cfg.Title or "Button",
                Callback = cfg.Callback or function() end
            })
        end

        function TabProxy:AddDivider()
            local s = sec()
            if type(s.AddDivider) == "function" then
                s:AddDivider()
            else
                -- fallback kalau remote K1 belum ada AddDivider
                s:AddParagraph({
                    Title = "",
                    Content = "────────────────────────"
                })
            end
        end

        function TabProxy:AddSubSection(title)
            sec():AddSubSection(title or "Sub Section")
        end

        function TabProxy:AddParagraph(cfg)
            cfg = cfg or {}
            local p = sec():AddParagraph({
                Title = cfg.Title or "",
                Content = cfg.Content or cfg.Description or ""
            })
            local proxy = type(p) == "table" and p or {}
            if type(proxy.SetDesc) ~= "function" then
                function proxy:SetDesc(text)
                    if self.SetContent then
                        self:SetContent(text)
                    end
                end
            end
            return proxy
        end

        function TabProxy:AddDropdown(nameOrCfg, cfg)
            local opts = type(nameOrCfg) == "string" and (cfg or {}) or (nameOrCfg or {})
            if type(nameOrCfg) == "string" then opts.Title = opts.Title or nameOrCfg end
            local userCb = opts.Callback or function() end
            local dd = sec():AddDropdown({
                Title = opts.Title or "Dropdown",
                Content = opts.Description or opts.Content or "",
                Options = opts.Options or opts.Values or {},
                Default = opts.Default,
                Multi = opts.Multi or false,
                Callback = function(v) pcall(userCb, v) end
            })
            local proxy = type(dd) == "table" and dd or {}
            -- CRITICAL: proxy == dd (same table). Save native methods BEFORE overwrite.
            local nativeSetValues = (type(dd) == "table" and type(dd.SetValues) == "function") and dd.SetValues or nil
            local nativeClear = (type(dd) == "table" and type(dd.Clear) == "function") and dd.Clear or nil
            local nativeAddOption = (type(dd) == "table" and type(dd.AddOption) == "function") and dd.AddOption or nil
            local nativeSet = (type(dd) == "table" and type(dd.Set) == "function") and dd.Set or nil
            local nativeRefresh = (type(dd) == "table" and type(dd.Refresh) == "function") and dd.Refresh or nil

            function proxy:OnChanged(cb)
                userCb = cb or userCb
                return proxy
            end
            function proxy:SetValue(v)
                if nativeSet then
                    pcall(function() nativeSet(dd, v) end)
                elseif dd and dd.Set then
                    pcall(function() dd:Set(v) end)
                end
            end
            -- Dynamic option list — call Kaizen native SetValues, never recurse
            function proxy:SetValues(list, selecting, silent)
                list = list or {}
                if type(nativeSetValues) == "function" then
                    -- Kaizen: SetValues(newList, selecting, silent)
                    local ok = pcall(function()
                        nativeSetValues(dd, list, selecting, silent == true)
                    end)
                    if ok then
                        proxy.Options = list
                        proxy.Values = list
                        return
                    end
                end
                -- Manual rebuild fallback (Clear + AddOption + Set)
                if type(nativeClear) == "function" and type(nativeAddOption) == "function" then
                    pcall(function()
                        nativeClear(dd)
                        for _, v in ipairs(list) do
                            nativeAddOption(dd, v)
                        end
                        dd.Options = list
                        if type(nativeSet) == "function" then
                            nativeSet(dd, selecting or (opts.Multi and {} or nil), true)
                        end
                    end)
                elseif type(nativeRefresh) == "function" then
                    pcall(function() nativeRefresh(dd, list, true) end)
                else
                    if type(dd) == "table" then
                        dd.Options = list
                        dd.Values = list
                    end
                end
                proxy.Options = list
                proxy.Values = list
            end
            function proxy:Refresh(list, clear)
                if type(list) == "table" then
                    proxy:SetValues(list)
                elseif type(nativeRefresh) == "function" then
                    pcall(function() nativeRefresh(dd, list, clear) end)
                end
            end
            if type(nameOrCfg) == "string" then
                selfRef.Options[nameOrCfg] = proxy
            end
            return proxy
        end

        function TabProxy:AddInput(nameOrCfg, cfg)
            local opts = type(nameOrCfg) == "string" and (cfg or {}) or (nameOrCfg or {})
            if type(nameOrCfg) == "string" then opts.Title = opts.Title or nameOrCfg end
            local userCb = opts.Callback or function() end
            local inp = sec():AddInput({
                Title = opts.Title or "Input",
                Content = opts.Description or opts.Placeholder or opts.Content or "",
                Default = opts.Default or "",
                Callback = function(v) pcall(userCb, v) end
            })
            local proxy = type(inp) == "table" and inp or {}
            function proxy:OnChanged(cb)
                userCb = cb or userCb
                return proxy
            end
            function proxy:SetValue(v)
                if inp and inp.Set then inp:Set(v) end
            end
            if type(nameOrCfg) == "string" then
                selfRef.Options[nameOrCfg] = proxy
            end
            return proxy
        end

        function TabProxy:AddSlider(nameOrCfg, cfg)
            local opts = type(nameOrCfg) == "string" and (cfg or {}) or (nameOrCfg or {})
            if type(nameOrCfg) == "string" then opts.Title = opts.Title or nameOrCfg end
            local userCb = opts.Callback or function() end
            local sl = sec():AddSlider({
                Title = opts.Title or "Slider",
                Content = opts.Description or "",
                Min = opts.Min or 0,
                Max = opts.Max or 100,
                Default = opts.Default or 0,
                Callback = function(v) pcall(userCb, v) end
            })
            local proxy = type(sl) == "table" and sl or {}
            function proxy:OnChanged(cb)
                userCb = cb or userCb
                return proxy
            end
            function proxy:SetValue(v)
                if sl and sl.Set then sl:Set(v) end
            end
            if type(nameOrCfg) == "string" then
                selfRef.Options[nameOrCfg] = proxy
            end
            return proxy
        end

        return TabProxy
    end

    return WindowProxy
end

