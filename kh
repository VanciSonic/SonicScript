end

function GetQuestAtribute()
    local level = getLevel()

    local result = {
        NpcName = nil,
        NpcPos = nil,
        NpcTargetName = nil,
        NpcTargetPos = nil,
        IslandName = nil,
        QuestName = nil,
        QuestKey = nil,
        LevelReq = nil,
        QuestIndex = nil,
        Targets = {},
    }

    -- Special hardcoded rule dari system lama
    if level >= 210 and level <= 249 then
        result.NpcName = "PrisonerQuest"
        result.NpcPos = Vector3.new(
            5308.93115,
            1.65517521,
            475.120514
        )
        result.IslandName = "Prison"
        result.QuestName = "Dangerous Prisoner"
        result.QuestKey = "PrisonerQuest"
        result.LevelReq = 210
        result.QuestIndex = 2
        result.NpcTargetName = "Dangerous Prisoner"
        result.NpcTargetPos = Vector3.new(
            5654.5634765625,
            15.633401870728,
            866.2991943359375
        )
        result.Targets = {
            {
                Name = "Dangerous Prisoner",
                Count = 8,
                Pos = result.NpcTargetPos
            }
        }
        return result
    end

    -- Auto Level hanya boleh memilih regular leveling quest.
    -- Special quest seperti Bartilo tidak ikut resolver ini.
    local blocked = {
        BartiloQuest = true,
        CitizenQuest = true
    }

    local bestQuest
    local bestKey
    local bestIndex

    for questKey, questList in pairs(Quests) do
        if not blocked[questKey] and type(questList) == "table" then
            for index, quest in ipairs(questList) do
                if type(quest) == "table"
                    and type(quest.LevelReq) == "number"
                    and quest.LevelReq <= level
                    and type(quest.Task) == "table"
                    and not isBossQuest(quest)
                then
                    if not bestQuest
                        or quest.LevelReq > bestQuest.LevelReq
                    then
                        bestQuest = quest
                        bestKey = questKey
                        bestIndex = index
                    end
                end
            end
        end
    end

    if not bestQuest then
        return result
    end

    result.QuestName = bestQuest.Name
    result.QuestKey = bestKey
    result.LevelReq = bestQuest.LevelReq
    result.QuestIndex = bestIndex

    -- QuestKey dipakai untuk menemukan NPC yang benar.
    -- Jangan gunakan nearest NPC sebagai sumber QuestKey,
    -- karena pada level tertentu nearest NPC bisa merupakan special quest.
    local npcData = findNPCEntry(bestKey)

    if npcData then
        result.NpcName = npcData.NPCName or bestKey
        result.NpcPos = npcData.Position
    else
        -- Fallback hanya untuk posisi NPC, bukan untuk menentukan quest.
        local myPos = getPos()
        local r = GuideModule:GetNearestNPC(myPos, level)

        if type(r) == "table" and r[1] then
            result.NpcName = r[2] or bestKey
            result.NpcPos = r[1]
            result.IslandName = (r[3] and r[3].Name)
                or nearestIsland(r[1])
        else
            result.NpcName = bestKey
        end
    end

    if result.NpcPos then
        result.IslandName = result.IslandName
            or nearestIsland(result.NpcPos)
    end

    -- Target diambil langsung dari Task quest yang sudah dipilih.
    for mobName, count in pairs(bestQuest.Task) do
        local pos = findMobPos(mobName)

        table.insert(result.Targets, {
            Name = mobName,
            Count = count,
            Pos = pos,
        })

        if not result.NpcTargetName then
            result.NpcTargetName = mobName
            result.NpcTargetPos = pos
        end
    end

    return result
end

